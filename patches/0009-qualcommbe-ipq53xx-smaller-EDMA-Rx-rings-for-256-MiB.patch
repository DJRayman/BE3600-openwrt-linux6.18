From 3d22ac66ff1234cebf6a722e3072882f229f21ba Mon Sep 17 00:00:00 2001
From: OpenWrt-Xiaomi-RD16-port <rd16@localhost>
Date: Fri, 23 Oct 2026 07:47:05 +0000
Subject: [PATCH] qualcommbe: ipq53xx: smaller EDMA Rx rings for 256 MiB

Add patch 9116: 512 instead of 2048 Rx buffers per EDMA Rx fill ring,
which frees about 15 MiB. With 2048 the hostapd process was killed by
the OOM killer during a full-speed Wi-Fi upload test.
---
 ...t-qualcomm-ppe-smaller-EDMA-Rx-rings.patch | 31 +++++++++++++++++++
 1 file changed, 31 insertions(+)
 create mode 100644 target/linux/qualcommbe/patches-6.18/9116-net-ethernet-qualcomm-ppe-smaller-EDMA-Rx-rings.patch

diff --git a/target/linux/qualcommbe/patches-6.18/9116-net-ethernet-qualcomm-ppe-smaller-EDMA-Rx-rings.patch b/target/linux/qualcommbe/patches-6.18/9116-net-ethernet-qualcomm-ppe-smaller-EDMA-Rx-rings.patch
new file mode 100644
index 0000000..cf651a0
--- /dev/null
+++ b/target/linux/qualcommbe/patches-6.18/9116-net-ethernet-qualcomm-ppe-smaller-EDMA-Rx-rings.patch
@@ -0,0 +1,31 @@
+From 0b83ef22fbde2b820bdf27e764d1cd3acd72320d Mon Sep 17 00:00:00 2001
+From: OpenWrt-Xiaomi-RD16-port <rd16@localhost>
+Date: Fri, 23 Oct 2026 07:46:55 +0000
+Subject: [PATCH] net: ethernet: qualcomm: ppe: smaller EDMA Rx rings for 256
+ MiB boards
+
+Each of the four Rx fill rings keeps 2048 buffers of about 2.4 KiB
+posted, about 20 MiB in all. On a 256 MiB IPQ5332 board, where Linux
+manages about 170 MiB and ath12k takes most of it, that leaves too
+little for bursts: a Wi-Fi upload at full speed ends in the OOM killer.
+
+512 buffers per ring (about 5 MiB) still cover several milliseconds at
+line rate per ring; the Rx flow control thresholds (32/64) are well
+below that.
+---
+ drivers/net/ethernet/qualcomm/ppe/edma_rx.h | 2 +-
+ 1 file changed, 1 insertion(+), 1 deletion(-)
+
+diff --git a/drivers/net/ethernet/qualcomm/ppe/edma_rx.h b/drivers/net/ethernet/qualcomm/ppe/edma_rx.h
+index 181a06421..fd6838697 100644
+--- a/drivers/net/ethernet/qualcomm/ppe/edma_rx.h
++++ b/drivers/net/ethernet/qualcomm/ppe/edma_rx.h
+@@ -28,7 +28,7 @@
+ #define EDMA_RXDESC_SEC_DESC(R, i)	EDMA_GET_SDESC(R, i, \
+ 						struct edma_rxdesc_sec)
+ 
+-#define EDMA_RX_RING_SIZE	2048
++#define EDMA_RX_RING_SIZE	512
+ 
+ #define EDMA_RX_RING_SIZE_MASK	(EDMA_RX_RING_SIZE - 1)
+ #define EDMA_RX_RING_ID_MASK		0x1F
-- 
