++static int ppe_flow_block_cb(enum tc_setup_type type, void *type_data,
++			     void *cb_priv)
++{
++	struct net_device *dev = cb_priv;
++
++	if (type != TC_SETUP_CLSFLOWER || !tc_can_offload(dev) ||
++	    !ppe_flow_ctx)
++		return -EOPNOTSUPP;
++
++	return ppe_flow_cmd(ppe_flow_ctx, type_data);
++}
