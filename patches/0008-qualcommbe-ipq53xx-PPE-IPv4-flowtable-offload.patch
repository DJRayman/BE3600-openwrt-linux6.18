++static int ppe_flow_cmd(struct ppe_flow *flow, struct flow_cls_offload *cls)
++{
++	int ret;
++
++	mutex_lock(&flow->lock);
++
++	if (!flow->hw_ready) {
++		ret = ppe_flow_hw_init(flow);
++		if (ret)
++			goto out;
++		flow->hw_ready = true;
++	}
++
++	switch (cls->command) {
++	case FLOW_CLS_REPLACE:
++		ret = ppe_flow_replace(flow, cls);
++		break;
++	case FLOW_CLS_DESTROY:
++		ret = ppe_flow_destroy(flow, cls);
++		break;
++	case FLOW_CLS_STATS:
++		ret = ppe_flow_stats(flow, cls);
++		break;
++	default:
++		ret = -EOPNOTSUPP;
++		break;
++	}
++
++out:
++	mutex_unlock(&flow->lock);
++
++	return ret;
++}
