++/* Global L3 settings: only flow hits are routed, everything else goes to the
++ * CPU, as do frames failing an MTU check and TCP control segments.
++ */
++static int ppe_flow_hw_init(struct ppe_flow *flow)
++{
++	struct regmap *regmap = flow->ppe_dev->regmap;
++	u32 mask = 0, val = 0, dir_val, cmd;
++	int ret, dir;
++
++	cmd = PPE_FLOW_ACTION_REDIRECT_TO_CPU;
++	ret = regmap_update_bits(regmap, PPE_L3_ROUTE_CTRL_ADDR,
++				 PPE_L3_ROUTE_CTRL_MRU_FAIL_CMD |
++				 PPE_L3_ROUTE_CTRL_MRU_FAIL_DE_ACCE |
++				 PPE_L3_ROUTE_CTRL_MTU_FAIL_CMD |
++				 PPE_L3_ROUTE_CTRL_MTU_FAIL_DE_ACCE |
++				 PPE_L3_ROUTE_CTRL_MTU_DF_FAIL_CMD |
++				 PPE_L3_ROUTE_CTRL_MTU_DF_FAIL_DE_ACCE,
++				 FIELD_PREP(PPE_L3_ROUTE_CTRL_MRU_FAIL_CMD, cmd) |
++				 PPE_L3_ROUTE_CTRL_MRU_FAIL_DE_ACCE |
++				 FIELD_PREP(PPE_L3_ROUTE_CTRL_MTU_FAIL_CMD, cmd) |
++				 PPE_L3_ROUTE_CTRL_MTU_FAIL_DE_ACCE |
++				 FIELD_PREP(PPE_L3_ROUTE_CTRL_MTU_DF_FAIL_CMD, cmd));
++	if (ret)
++		return ret;
++
++	ret = regmap_update_bits(regmap, PPE_L3_ROUTE_CTRL_EXT_ADDR,
++				 PPE_L3_ROUTE_CTRL_EXT_ROUTE_MISMATCH |
++				 PPE_L3_ROUTE_CTRL_EXT_PMTU_FAIL_CMD |
++				 PPE_L3_ROUTE_CTRL_EXT_PMTU_FAIL_DE_ACCE |
++				 PPE_L3_ROUTE_CTRL_EXT_PMTU_DF_FAIL_CMD |
++				 PPE_L3_ROUTE_CTRL_EXT_PMTU_DF_DE_ACCE,
++				 FIELD_PREP(PPE_L3_ROUTE_CTRL_EXT_ROUTE_MISMATCH, cmd) |
++				 FIELD_PREP(PPE_L3_ROUTE_CTRL_EXT_PMTU_FAIL_CMD, cmd) |
++				 FIELD_PREP(PPE_L3_ROUTE_CTRL_EXT_PMTU_DF_FAIL_CMD, cmd));
++	if (ret)
++		return ret;
++
++	dir_val = FIELD_PREP(PPE_FLOW_CTRL1_MISS_CMD, cmd) |
++		  PPE_FLOW_CTRL1_FRAG_BYPASS;
++	if (tcp_special_bypass)
++		dir_val |= PPE_FLOW_CTRL1_TCP_SPECIAL;
++
++	for (dir = 0; dir < PPE_FLOW_CTRL1_DIRS; dir++) {
++		mask |= PPE_FLOW_CTRL1_DIR_MASK << PPE_FLOW_CTRL1_DIR_SHIFT(dir);
++		val |= dir_val << PPE_FLOW_CTRL1_DIR_SHIFT(dir);
++	}
++
++	ret = regmap_update_bits(regmap, PPE_FLOW_CTRL1_ADDR +
++				 PPE_FLOW_CTRL1_INC * PPE_FLOW_CTRL1_L3_UNICAST,
++				 mask, val);
++	if (ret)
++		return ret;
++
++	return regmap_set_bits(regmap, PPE_FLOW_CTRL0_ADDR,
++			       PPE_FLOW_CTRL0_FLOW_EN);
++}
