+ drivers/net/ethernet/qualcomm/ppe/Makefile    |    2 +
+ drivers/net/ethernet/qualcomm/ppe/edma_port.c |   17 +
+ drivers/net/ethernet/qualcomm/ppe/edma_port.h |    1 +
+ drivers/net/ethernet/qualcomm/ppe/ppe.c       |    7 +
+ drivers/net/ethernet/qualcomm/ppe/ppe_flow.c  | 1447 +++++++++++++++++
+ drivers/net/ethernet/qualcomm/ppe/ppe_flow.h  |   37 +
+ drivers/net/ethernet/qualcomm/ppe/ppe_regs.h  |  160 ++
+ 8 files changed, 1682 insertions(+)
+ create mode 100644 drivers/net/ethernet/qualcomm/ppe/ppe_flow.c
+ create mode 100644 drivers/net/ethernet/qualcomm/ppe/ppe_flow.h
+
