++static void ppe_flow_entry_destroy(struct ppe_flow *flow,
++				   struct ppe_flow_entry *entry)
++{
++	ppe_flow_hash_op(flow, false, PPE_TBL_OP_DEL, PPE_TBL_OP_MODE_INDEX,
++			 NULL, 0, &entry->index);
++	rhashtable_remove_fast(&flow->entries, &entry->node, ppe_flow_ht_params);
++	list_del(&entry->list);
++	flow->num_entries--;
