++/* Read the hit counters of a flow, and clear them when asked to. */
++static int ppe_flow_counters(struct ppe_flow *flow,
++			     struct ppe_flow_entry *entry, u64 *packets,
++			     u64 *bytes, bool clear)
++{
++	u32 addr = PPE_IN_FLOW_CNT_TBL_ADDR +
++		   PPE_IN_FLOW_CNT_TBL_INC * entry->index;
++	u32 buf[3], zero[3] = {};
++	int ret;
++
++	ret = ppe_flow_tbl_read(flow, addr, buf, ARRAY_SIZE(buf));
++	if (ret)
++		return ret;
++
++	*packets = ppe_flow_field_get(buf, PPE_IN_FLOW_CNT_W_PKTS);
++	*bytes = ppe_flow_field_get(buf, PPE_IN_FLOW_CNT_W_BYTES_LO) |
++		 (u64)ppe_flow_field_get(buf, PPE_IN_FLOW_CNT_W_BYTES_HI) << 32;
++
++	if (clear && *packets)
++		ret = ppe_flow_tbl_write(flow, addr, zero, ARRAY_SIZE(zero));
++
++	return ret;
++}
++
++static int ppe_flow_stats(struct ppe_flow *flow, struct flow_cls_offload *f)
++{
++	struct ppe_flow_entry *entry;
++	u64 packets, bytes;
++	int ret;
++
++	entry = rhashtable_lookup_fast(&flow->entries, &f->cookie,
++				       ppe_flow_ht_params);
++	if (!entry)
++		return -ENOENT;
++
++	ret = ppe_flow_counters(flow, entry, &packets, &bytes, true);
++	if (ret)
++		return ret;
++
++	if (packets) {
++		entry->packets += packets;
++		entry->bytes += bytes;
++		flow_stats_update(&f->stats, bytes, packets, 0, jiffies,
++				  FLOW_ACTION_HW_STATS_IMMEDIATE);
++	}
++
++	return 0;
++}
