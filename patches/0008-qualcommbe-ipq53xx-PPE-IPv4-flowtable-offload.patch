+--- a/drivers/net/ethernet/qualcomm/ppe/edma_port.h
++++ b/drivers/net/ethernet/qualcomm/ppe/edma_port.h
+@@ -92,6 +92,7 @@ struct edma_port_priv {
+ 	unsigned long flags;
+ };
+ 
++bool edma_port_is_edma_netdev(const struct net_device *netdev);
+ void edma_port_destroy(struct ppe_port *port);
+ int edma_port_setup(struct ppe_port *port);
+ #endif
+diff --git a/drivers/net/ethernet/qualcomm/ppe/ppe.c b/drivers/net/ethernet/qualcomm/ppe/ppe.c
+index da982264e..b631608f6 100644
+--- a/drivers/net/ethernet/qualcomm/ppe/ppe.c
++++ b/drivers/net/ethernet/qualcomm/ppe/ppe.c
+@@ -18,6 +18,7 @@
+ #include "ppe.h"
+ #include "ppe_config.h"
+ #include "ppe_debugfs.h"
++#include "ppe_flow.h"
+ #include "ppe_port.h"
+ 
+ #define PPE_PORT_MAX		8
+@@ -253,6 +254,11 @@ static int qcom_ppe_probe(struct platform_device *pdev)
+ 	}
+ 
+ 	ppe_debugfs_setup(ppe_dev);
++
++	ret = ppe_flow_init(ppe_dev);
++	if (ret)
++		dev_warn(dev, "PPE flow offload unavailable: %d\n", ret);
++
+ 	platform_set_drvdata(pdev, ppe_dev);
+ 
+ 	return 0;
+@@ -263,6 +269,7 @@ static void qcom_ppe_remove(struct platform_device *pdev)
+ 	struct ppe_device *ppe_dev;
+ 
+ 	ppe_dev = platform_get_drvdata(pdev);
++	ppe_flow_deinit(ppe_dev);
+ 	ppe_port_mac_deinit(ppe_dev);
+ 	ppe_debugfs_teardown(ppe_dev);
+ 	edma_destroy(ppe_dev);
+diff --git a/drivers/net/ethernet/qualcomm/ppe/ppe_flow.c b/drivers/net/ethernet/qualcomm/ppe/ppe_flow.c
+new file mode 100644
+index 000000000..4f4bf6442
+--- /dev/null
++++ b/drivers/net/ethernet/qualcomm/ppe/ppe_flow.c
+@@ -0,0 +1,1447 @@
++// SPDX-License-Identifier: GPL-2.0-only
++/*
++ * Copyright (c) Qualcomm Technologies, Inc. and/or its subsidiaries.
++ */
++
++/* PPE IPv4 flow offload for the netfilter flowtable.
++ *
++ * A flowtable with the offload flag hands each direction of a connection
++ * to the driver as a flow rule. A rule becomes:
++ *
++ *  - a host table entry for the source address, which the flow key refers to;
++ *  - a flow table entry keyed by the destination address, the L4 ports, the
++ *    protocol and that host entry, giving the forwarding type (route, SNAT or
++ *    DNAT), the translated port and a nexthop;
++ *  - a nexthop holding the egress port, destination MAC, the egress L3
++ *    interface that supplies the source MAC, the VLAN to push and the
++ *    translated address (public address index or DNAT address).
++ *
++ * Routing is enabled only on the ingress L3 interface of the ports that have
++ * offloaded flows, and only for frames addressed to one of the router MACs
++ * registered in MY_MAC by those flows. A flow table miss is redirected to the
++ * CPU, so the PPE never routes on its own and every other frame takes the
++ * existing path to the CPU.
++ *
++ * Behind a DSA switch using the yt921x-8021q tagger, frames to a user port
++ * leave the PPE tagged with that port's TX VLAN, exactly as the tagger would
++ * have sent them.
++ */
++
++#include <linux/bitfield.h>
++#include <linux/debugfs.h>
++#include <linux/etherdevice.h>
++#include <linux/if_ether.h>
++#include <linux/if_vlan.h>
++#include <linux/in.h>
++#include <linux/ip.h>
++#include <linux/moduleparam.h>
++#include <linux/mutex.h>
++#include <linux/netdevice.h>
++#include <linux/regmap.h>
++#include <linux/rhashtable.h>
++#include <linux/seq_file.h>
++#include <linux/slab.h>
++#include <net/dsa.h>
++#include <net/flow_offload.h>
++#include <net/pkt_cls.h>
++
++#if IS_ENABLED(CONFIG_NET_DSA_TAG_YT921X_8021Q)
++#include <linux/dsa/yt921x.h>
++#endif
++
++#include "edma_port.h"
++#include "ppe.h"
++#include "ppe_flow.h"
++#include "ppe_regs.h"
++
++#define PPE_FLOW_ACTION_FORWARD		0
++#define PPE_FLOW_ACTION_REDIRECT_TO_CPU	3
++
++/* Index of the ingress L3 interface of a PPE port, and of the egress L3
++ * interface that carries router MAC number n.
++ */
++#define PPE_FLOW_IN_L3_IF(port)		(port)
++#define PPE_FLOW_EG_L3_IF(n)		(16 + (n))
++
++#define PPE_FLOW_L3_MTU			9216
++#define PPE_FLOW_ENTRY_WORDS		6
++#define PPE_FLOW_HOST_WORDS		3
++#define PPE_FLOW_NEXTHOP_WORDS		4
++#define PPE_FLOW_OP_TIMEOUT_US		1000
++
++static bool host_redirect = true;
++module_param(host_redirect, bool, 0644);
++MODULE_PARM_DESC(host_redirect,
++		 "Redirect host route hits of flow source addresses to the CPU (default: true)");
++
++static bool tcp_special_bypass = true;
++module_param(tcp_special_bypass, bool, 0644);
++MODULE_PARM_DESC(tcp_special_bypass,
++		 "Send TCP SYN, FIN and RST of offloaded flows to the CPU (default: true)");
++
++struct ppe_flow_host {
++	struct list_head list;
++	__be32 addr;
++	u16 index;
++	unsigned int refcnt;
++};
++
++struct ppe_flow_nexthop {
++	struct list_head list;
++	u16 index;
++	unsigned int refcnt;
++	int port;
++	int mac_slot;
++	int pub_ip;
++	u16 cvid;
++	bool tagged;
++	u8 dmac[ETH_ALEN];
++	__be32 dnat_addr;
++};
++
++struct ppe_flow_entry {
++	struct rhash_head node;
++	struct list_head list;
++	unsigned long cookie;
++	u16 index;
++	u8 fwd_type;
++	int in_port;
++	struct ppe_flow_host *host;
++	struct ppe_flow_nexthop *nh;
++	/* Router MAC slots this flow holds: egress source MAC, ingress MACs. */
++	int mac_slots[3];
++	int num_mac_slots;
++	/* Flow tuple, for debugfs. */
++	__be32 saddr, daddr, new_addr;
++	__be16 sport, dport, new_port;
++	u8 l4proto;
++	u64 packets;
++	u64 bytes;
++};
++
++struct ppe_flow_mac {
++	u8 addr[ETH_ALEN];
++	unsigned int refcnt;
++};
++
++struct ppe_flow_pub_ip {
++	__be32 addr;
++	unsigned int refcnt;
++};
++
++struct ppe_flow {
++	struct ppe_device *ppe_dev;
++	struct mutex lock; /* Protects everything below and the PPE tables */
++	struct rhashtable entries;
++	struct list_head entry_list;
++	struct list_head hosts;
++	struct list_head nexthops;
++	unsigned long *nh_map;
++	unsigned int nh_num;
++	struct ppe_flow_mac macs[PPE_MY_MAC_TBL_ENTRIES];
++	struct ppe_flow_pub_ip pub_ips[PPE_IN_PUB_IP_ADDR_TBL_ENTRIES];
++	unsigned long in_ports;
++	unsigned int num_entries;
++	u8 flow_cmd_id;
++	u8 host_cmd_id;
++	bool hw_ready;
++	struct dentry *debugfs;
++};
++
++static const struct rhashtable_params ppe_flow_ht_params = {
++	.head_offset = offsetof(struct ppe_flow_entry, node),
++	.key_offset = offsetof(struct ppe_flow_entry, cookie),
++	.key_len = sizeof(unsigned long),
++	.automatic_shrinking = true,
++};
++
++static struct ppe_flow *ppe_flow_ctx;
++
++/* Table entries are arrays of 32-bit words; a field may cross a word. */
++static void ppe_flow_field_set(u32 *buf, u32 field, u32 val)
++{
++	unsigned int lsb = PPE_TBL_FIELD_LSB(field);
++	unsigned int width = PPE_TBL_FIELD_WIDTH(field);
++	unsigned int done = 0;
++
++	while (done < width) {
++		unsigned int bit = (lsb + done) % 32;
++		unsigned int n = min(width - done, 32 - bit);
++		u32 mask = GENMASK(bit + n - 1, bit);
++		u32 *word = &buf[(lsb + done) / 32];
++
++		*word = (*word & ~mask) | (((val >> done) << bit) & mask);
++		done += n;
++	}
++}
++
++static u32 ppe_flow_field_get(const u32 *buf, u32 field)
++{
++	unsigned int lsb = PPE_TBL_FIELD_LSB(field);
++	unsigned int width = PPE_TBL_FIELD_WIDTH(field);
++	unsigned int done = 0;
++	u32 val = 0;
++
++	while (done < width) {
++		unsigned int bit = (lsb + done) % 32;
++		unsigned int n = min(width - done, 32 - bit);
++		u32 word = buf[(lsb + done) / 32];
++
++		val |= ((word >> bit) & GENMASK(n - 1, 0)) << done;
++		done += n;
++	}
++
++	return val;
++}
++
++/* MACs are stored as the low 16 bits (bytes 4 and 5) and the high 32 bits
++ * (bytes 0 to 3) in the nexthop table, and the other way round, low 32 and
++ * high 16 bits, in MY_MAC and the egress L3 interface table.
++ */
++static u32 ppe_flow_mac_lo32(const u8 *mac)
++{
++	return mac[2] << 24 | mac[3] << 16 | mac[4] << 8 | mac[5];
++}
++
++static u32 ppe_flow_mac_hi16(const u8 *mac)
++{
++	return mac[0] << 8 | mac[1];
++}
++
++static int ppe_flow_tbl_write(struct ppe_flow *flow, u32 addr,
++			      const u32 *buf, size_t words)
++{
++	return regmap_bulk_write(flow->ppe_dev->regmap, addr, buf, words);
++}
++
++static int ppe_flow_tbl_read(struct ppe_flow *flow, u32 addr, u32 *buf,
++			     size_t words)
++{
++	return regmap_bulk_read(flow->ppe_dev->regmap, addr, buf, words);
++}
++
++/* Run an add or delete on the flow or host table and return the index the
++ * hardware used. In hash mode the entry data is written first and the
++ * hardware picks the slot; in index mode the given entry is removed.
++ */
++static int ppe_flow_hash_op(struct ppe_flow *flow, bool host, u32 op_type,
++			    u32 op_mode, const u32 *data, size_t words,
++			    u16 *index)
++{
++	struct regmap *regmap = flow->ppe_dev->regmap;
++	u32 op_addr, data_addr, rslt_addr, op, rslt, cmd_id, valid_mask;
++	int ret, i;
++
++	if (host) {
++		op_addr = PPE_HOST_TBL_OP_ADDR;
++		data_addr = PPE_HOST_TBL_OP_DATA_ADDR;
++		rslt_addr = PPE_HOST_TBL_OP_RSLT_ADDR;
++		valid_mask = PPE_HOST_TBL_RSLT_VALID_CNT;
++		cmd_id = flow->host_cmd_id++ & 0xf;
++		op = FIELD_PREP(PPE_HOST_TBL_OP_CMD_ID, cmd_id) |
++		     FIELD_PREP(PPE_HOST_TBL_OP_TYPE, op_type) |
++		     FIELD_PREP(PPE_HOST_TBL_OP_HASH_BLOCK, 3) |
++		     FIELD_PREP(PPE_HOST_TBL_OP_MODE, op_mode) |
++		     FIELD_PREP(PPE_HOST_TBL_OP_INDEX, *index);
++	} else {
++		op_addr = PPE_IN_FLOW_TBL_OP_ADDR;
++		data_addr = PPE_IN_FLOW_TBL_OP_DATA_ADDR;
++		rslt_addr = PPE_IN_FLOW_TBL_OP_RSLT_ADDR;
++		valid_mask = PPE_IN_FLOW_TBL_RSLT_VALID_CNT;
++		cmd_id = flow->flow_cmd_id++ & 0xf;
++		op = FIELD_PREP(PPE_IN_FLOW_TBL_OP_CMD_ID, cmd_id) |
++		     FIELD_PREP(PPE_IN_FLOW_TBL_OP_TYPE, op_type) |
++		     FIELD_PREP(PPE_IN_FLOW_TBL_OP_HASH_BLOCK, 3) |
++		     FIELD_PREP(PPE_IN_FLOW_TBL_OP_MODE, op_mode) |
++		     FIELD_PREP(PPE_IN_FLOW_TBL_OP_INDEX, *index);
++	}
++
++	if (op_mode == PPE_TBL_OP_MODE_HASH) {
++		for (i = 0; i < words; i++) {
++			ret = regmap_write(regmap, data_addr + 4 * i, data[i]);
++			if (ret)
++				return ret;
++		}
++	}
++
++	ret = regmap_write(regmap, op_addr, op);
++	if (ret)
++		return ret;
++
++	ret = regmap_read_poll_timeout(regmap, rslt_addr, rslt,
++				       rslt & valid_mask, 0,
++				       PPE_FLOW_OP_TIMEOUT_US);
++	if (ret)
++		return ret;
++
++	if (host) {
++		if (FIELD_GET(PPE_HOST_TBL_RSLT_CMD_ID, rslt) != cmd_id)
++			dev_dbg(flow->ppe_dev->dev, "host op %u got result %lu\n",
++				cmd_id, FIELD_GET(PPE_HOST_TBL_RSLT_CMD_ID, rslt));
++		if (rslt & PPE_HOST_TBL_RSLT_FAIL)
++			return -ENOSPC;
++		*index = FIELD_GET(PPE_HOST_TBL_RSLT_INDEX, rslt);
++	} else {
++		if (FIELD_GET(PPE_IN_FLOW_TBL_RSLT_CMD_ID, rslt) != cmd_id)
++			dev_dbg(flow->ppe_dev->dev, "flow op %u got result %lu\n",
++				cmd_id, FIELD_GET(PPE_IN_FLOW_TBL_RSLT_CMD_ID, rslt));
++		if (rslt & PPE_IN_FLOW_TBL_RSLT_FAIL)
++			return -ENOSPC;
++		*index = FIELD_GET(PPE_IN_FLOW_TBL_RSLT_INDEX, rslt);
++	}
++
++	return 0;
++}
++
++/* Rewrite the MY_MAC bitmap of every ingress L3 interface in use. */
++static int ppe_flow_in_l3_if_sync(struct ppe_flow *flow)
++{
++	u32 bitmap = 0, buf[3];
++	int i, port, ret;
++
++	for (i = 0; i < PPE_MY_MAC_TBL_ENTRIES; i++)
++		if (flow->macs[i].refcnt)
++			bitmap |= BIT(i);
++
++	for_each_set_bit(port, &flow->in_ports, BITS_PER_LONG) {
++		u32 addr = PPE_IN_L3_IF_TBL_ADDR +
++			   PPE_IN_L3_IF_TBL_INC * PPE_FLOW_IN_L3_IF(port);
++
++		ret = ppe_flow_tbl_read(flow, addr, buf, ARRAY_SIZE(buf));
++		if (ret)
++			return ret;
++
++		ppe_flow_field_set(buf, PPE_IN_L3_IF_W_MAC_BITMAP, bitmap);
++		ret = ppe_flow_tbl_write(flow, addr, buf, ARRAY_SIZE(buf));
++		if (ret)
++			return ret;
++	}
++
++	return 0;
++}
++
++/* Route IPv4 unicast received on a PPE port through its own L3 interface. */
++static int ppe_flow_in_port_enable(struct ppe_flow *flow, int port)
++{
++	u32 addr, buf[4] = {};
++	int ret;
++
++	if (test_bit(port, &flow->in_ports))
++		return 0;
++
++	ppe_flow_field_set(buf, PPE_IN_L3_IF_W_MRU, PPE_FLOW_L3_MTU);
++	ppe_flow_field_set(buf, PPE_IN_L3_IF_W_MTU, PPE_FLOW_L3_MTU);
++	ppe_flow_field_set(buf, PPE_IN_L3_IF_W_IPV4_UC_ROUTE_EN, 1);
++	ppe_flow_field_set(buf, PPE_IN_L3_IF_W_TTL_EXCEED_CMD,
++			   PPE_FLOW_ACTION_REDIRECT_TO_CPU);
++	ppe_flow_field_set(buf, PPE_IN_L3_IF_W_TTL_EXCEED_DE_ACCE, 1);
++	ppe_flow_field_set(buf, PPE_IN_L3_IF_W_MRU_IPV6, PPE_FLOW_L3_MTU);
++	ppe_flow_field_set(buf, PPE_IN_L3_IF_W_MTU_IPV6, PPE_FLOW_L3_MTU);
++	addr = PPE_IN_L3_IF_TBL_ADDR +
++	       PPE_IN_L3_IF_TBL_INC * PPE_FLOW_IN_L3_IF(port);
++	ret = ppe_flow_tbl_write(flow, addr, buf, 3);
++	if (ret)
++		return ret;
++
++	addr = PPE_L3_VP_PORT_TBL_ADDR + PPE_L3_VP_PORT_TBL_INC * port;
++	ret = ppe_flow_tbl_read(flow, addr, buf, ARRAY_SIZE(buf));
++	if (ret)
++		return ret;
++
++	ppe_flow_field_set(buf, PPE_L3_VP_PORT_W_L3_IF_VALID, 1);
++	ppe_flow_field_set(buf, PPE_L3_VP_PORT_W_L3_IF_INDEX,
++			   PPE_FLOW_IN_L3_IF(port));
++	ret = ppe_flow_tbl_write(flow, addr, buf, ARRAY_SIZE(buf));
++	if (ret)
++		return ret;
++
++	set_bit(port, &flow->in_ports);
++
++	return ppe_flow_in_l3_if_sync(flow);
++}
++
++static void ppe_flow_in_port_disable(struct ppe_flow *flow, int port)
++{
++	u32 addr, buf[4] = {};
++
++	addr = PPE_L3_VP_PORT_TBL_ADDR + PPE_L3_VP_PORT_TBL_INC * port;
++	if (!ppe_flow_tbl_read(flow, addr, buf, ARRAY_SIZE(buf))) {
++		ppe_flow_field_set(buf, PPE_L3_VP_PORT_W_L3_IF_VALID, 0);
++		ppe_flow_field_set(buf, PPE_L3_VP_PORT_W_L3_IF_INDEX, 0);
++		ppe_flow_tbl_write(flow, addr, buf, ARRAY_SIZE(buf));
++	}
++
++	memset(buf, 0, sizeof(buf));
++	addr = PPE_IN_L3_IF_TBL_ADDR +
++	       PPE_IN_L3_IF_TBL_INC * PPE_FLOW_IN_L3_IF(port);
++	ppe_flow_tbl_write(flow, addr, buf, 3);
++
++	clear_bit(port, &flow->in_ports);
++}
++
++/* A router MAC: frames addressed to it are routed (MY_MAC), and flows leaving
++ * through it take it as source MAC (egress L3 interface).
++ */
++static int ppe_flow_mac_get(struct ppe_flow *flow, const u8 *addr)
++{
++	u32 buf[3] = {};
++	int i, free = -1, ret;
++
++	for (i = 0; i < PPE_MY_MAC_TBL_ENTRIES; i++) {
++		if (flow->macs[i].refcnt &&
++		    ether_addr_equal(flow->macs[i].addr, addr)) {
++			flow->macs[i].refcnt++;
++			return i;
++		}
++
++		if (!flow->macs[i].refcnt && free < 0)
++			free = i;
++	}
++
++	if (free < 0)
++		return -ENOSPC;
++
++	ppe_flow_field_set(buf, PPE_EG_L3_IF_W_MAC_LO, ppe_flow_mac_lo32(addr));
++	ppe_flow_field_set(buf, PPE_EG_L3_IF_W_MAC_HI, ppe_flow_mac_hi16(addr));
++	ret = ppe_flow_tbl_write(flow, PPE_EG_L3_IF_TBL_ADDR +
++				 PPE_EG_L3_IF_TBL_INC * PPE_FLOW_EG_L3_IF(free),
++				 buf, 3);
++	if (ret)
++		return ret;
++
++	memset(buf, 0, sizeof(buf));
++	ppe_flow_field_set(buf, PPE_MY_MAC_W_MAC_LO, ppe_flow_mac_lo32(addr));
++	ppe_flow_field_set(buf, PPE_MY_MAC_W_MAC_HI, ppe_flow_mac_hi16(addr));
++	ppe_flow_field_set(buf, PPE_MY_MAC_W_VALID, 1);
++	ret = ppe_flow_tbl_write(flow, PPE_MY_MAC_TBL_ADDR +
++				 PPE_MY_MAC_TBL_INC * free, buf, 2);
++	if (ret)
++		return ret;
++
++	ether_addr_copy(flow->macs[free].addr, addr);
++	flow->macs[free].refcnt = 1;
++
++	ret = ppe_flow_in_l3_if_sync(flow);
++	if (ret) {
++		flow->macs[free].refcnt = 0;
++		return ret;
++	}
++
++	return free;
++}
++
++static void ppe_flow_mac_put(struct ppe_flow *flow, int slot)
++{
++	u32 buf[3] = {};
++
++	if (--flow->macs[slot].refcnt)
++		return;
++
++	eth_zero_addr(flow->macs[slot].addr);
++	ppe_flow_in_l3_if_sync(flow);
++	ppe_flow_tbl_write(flow, PPE_MY_MAC_TBL_ADDR +
++			   PPE_MY_MAC_TBL_INC * slot, buf, 2);
++	ppe_flow_tbl_write(flow, PPE_EG_L3_IF_TBL_ADDR +
++			   PPE_EG_L3_IF_TBL_INC * PPE_FLOW_EG_L3_IF(slot),
++			   buf, 3);
++}
++
++static int ppe_flow_pub_ip_get(struct ppe_flow *flow, __be32 addr)
++{
++	int i, free = -1, ret;
++
++	for (i = 0; i < PPE_IN_PUB_IP_ADDR_TBL_ENTRIES; i++) {
++		if (flow->pub_ips[i].refcnt && flow->pub_ips[i].addr == addr) {
++			flow->pub_ips[i].refcnt++;
++			return i;
++		}
++
++		if (!flow->pub_ips[i].refcnt && free < 0)
++			free = i;
++	}
++
++	if (free < 0)
++		return -ENOSPC;
++
++	ret = regmap_write(flow->ppe_dev->regmap, PPE_IN_PUB_IP_ADDR_TBL_ADDR +
++			   PPE_IN_PUB_IP_ADDR_TBL_INC * free, be32_to_cpu(addr));
++	if (ret)
++		return ret;
++
++	flow->pub_ips[free].addr = addr;
++	flow->pub_ips[free].refcnt = 1;
++
++	return free;
++}
++
++static void ppe_flow_pub_ip_put(struct ppe_flow *flow, int index)
++{
++	if (--flow->pub_ips[index].refcnt)
++		return;
++
++	flow->pub_ips[index].addr = 0;
++	regmap_write(flow->ppe_dev->regmap, PPE_IN_PUB_IP_ADDR_TBL_ADDR +
++		     PPE_IN_PUB_IP_ADDR_TBL_INC * index, 0);
++}
++
++static struct ppe_flow_host *ppe_flow_host_get(struct ppe_flow *flow,
++					       __be32 addr)
++{
++	u32 buf[PPE_FLOW_HOST_WORDS] = {};
++	struct ppe_flow_host *host;
++	u16 index = 0;
++	int ret;
++
++	list_for_each_entry(host, &flow->hosts, list) {
++		if (host->addr == addr) {
++			host->refcnt++;
++			return host;
++		}
++	}
++
++	host = kzalloc(sizeof(*host), GFP_KERNEL);
++	if (!host)
++		return ERR_PTR(-ENOMEM);
++
++	/* The entry only names the address for the flow key. Should a routed
++	 * frame look up this address as its destination, it goes to the CPU.
++	 */
++	ppe_flow_field_set(buf, PPE_HOST_W_VALID, 1);
++	ppe_flow_field_set(buf, PPE_HOST_W_KEY_TYPE, 0);
++	ppe_flow_field_set(buf, PPE_HOST_W_FWD_CMD,
++			   host_redirect ? PPE_FLOW_ACTION_REDIRECT_TO_CPU :
++			   PPE_FLOW_ACTION_FORWARD);
++	ppe_flow_field_set(buf, PPE_HOST_W_IP_ADDR, be32_to_cpu(addr));
++
++	ret = ppe_flow_hash_op(flow, true, PPE_TBL_OP_ADD,
++			       PPE_TBL_OP_MODE_HASH, buf, ARRAY_SIZE(buf),
++			       &index);
++	if (ret) {
++		kfree(host);
++		return ERR_PTR(ret);
++	}
++
++	host->addr = addr;
++	host->index = index;
++	host->refcnt = 1;
++	list_add(&host->list, &flow->hosts);
++
++	return host;
++}
++
++static void ppe_flow_host_put(struct ppe_flow *flow, struct ppe_flow_host *host)
++{
++	u16 index = host->index;
++
++	if (--host->refcnt)
++		return;
++
++	ppe_flow_hash_op(flow, true, PPE_TBL_OP_DEL, PPE_TBL_OP_MODE_INDEX,
++			 NULL, 0, &index);
++	list_del(&host->list);
++	kfree(host);
++}
++
++static struct ppe_flow_nexthop *
++ppe_flow_nexthop_get(struct ppe_flow *flow, const struct ppe_flow_nexthop *key)
++{
++	u32 buf[PPE_FLOW_NEXTHOP_WORDS] = {};
++	struct ppe_flow_nexthop *nh;
++	unsigned int index;
++	int ret;
++
++	list_for_each_entry(nh, &flow->nexthops, list) {
++		if (nh->port == key->port && nh->mac_slot == key->mac_slot &&
++		    nh->pub_ip == key->pub_ip && nh->tagged == key->tagged &&
++		    nh->cvid == key->cvid && nh->dnat_addr == key->dnat_addr &&
++		    ether_addr_equal(nh->dmac, key->dmac)) {
++			nh->refcnt++;
++			return nh;
++		}
++	}
++
++	index = find_first_zero_bit(flow->nh_map, flow->nh_num);
++	if (index >= flow->nh_num)
++		return ERR_PTR(-ENOSPC);
++
++	nh = kmemdup(key, sizeof(*nh), GFP_KERNEL);
++	if (!nh)
++		return ERR_PTR(-ENOMEM);
++
++	ppe_flow_field_set(buf, PPE_IN_NEXTHOP_W_TYPE_PORT, 1);
++	ppe_flow_field_set(buf, PPE_IN_NEXTHOP_W_PORT, key->port);
++	ppe_flow_field_set(buf, PPE_IN_NEXTHOP_W_POST_L3_IF,
++			   PPE_FLOW_EG_L3_IF(key->mac_slot));
++	ppe_flow_field_set(buf, PPE_IN_NEXTHOP_W_CTAG_FMT, key->tagged);
++	ppe_flow_field_set(buf, PPE_IN_NEXTHOP_W_CVID, key->cvid);
++	ppe_flow_field_set(buf, PPE_IN_NEXTHOP_W_PUB_IP_INDEX,
++			   key->pub_ip >= 0 ? key->pub_ip : 0);
++	ppe_flow_field_set(buf, PPE_IN_NEXTHOP_W_MAC_LO,
++			   key->dmac[4] << 8 | key->dmac[5]);
++	ppe_flow_field_set(buf, PPE_IN_NEXTHOP_W_MAC_HI,
++			   key->dmac[0] << 24 | key->dmac[1] << 16 |
++			   key->dmac[2] << 8 | key->dmac[3]);
++	ppe_flow_field_set(buf, PPE_IN_NEXTHOP_W_DNAT_IP,
++			   be32_to_cpu(key->dnat_addr));
++
++	ret = ppe_flow_tbl_write(flow, PPE_IN_NEXTHOP_TBL_ADDR +
++				 PPE_IN_NEXTHOP_TBL_INC * index,
++				 buf, ARRAY_SIZE(buf));
++	if (ret) {
++		kfree(nh);
++		return ERR_PTR(ret);
++	}
++
++	set_bit(index, flow->nh_map);
++	nh->index = index;
++	nh->refcnt = 1;
++	list_add(&nh->list, &flow->nexthops);
++
++	return nh;
++}
++
++static void ppe_flow_nexthop_put(struct ppe_flow *flow,
++				 struct ppe_flow_nexthop *nh)
++{
++	u32 buf[PPE_FLOW_NEXTHOP_WORDS] = {};
++
++	if (--nh->refcnt)
++		return;
++
++	if (nh->pub_ip >= 0)
++		ppe_flow_pub_ip_put(flow, nh->pub_ip);
++
++	ppe_flow_tbl_write(flow, PPE_IN_NEXTHOP_TBL_ADDR +
++			   PPE_IN_NEXTHOP_TBL_INC * nh->index,
++			   buf, ARRAY_SIZE(buf));
++	clear_bit(nh->index, flow->nh_map);
++	list_del(&nh->list);
++	kfree(nh);
++}
++
++/* PPE port behind a net device: an EDMA port itself, or the conduit of a
++ * DSA user port. For a yt921x-8021q user port also return the VLAN that
++ * addresses the port.
++ */
++static int ppe_flow_dev_port(struct net_device *dev, bool *tagged, u16 *vid)
++{
++	struct edma_port_priv *port_priv;
++
++	*tagged = false;
++	*vid = 0;
++
++#if IS_REACHABLE(CONFIG_NET_DSA)
++	if (!edma_port_is_edma_netdev(dev)) {
++		struct dsa_port *dp = dsa_port_from_netdev(dev);
++
++		if (IS_ERR(dp))
++			return -EOPNOTSUPP;
++
++		switch (dp->cpu_dp->tag_ops->proto) {
++#if IS_ENABLED(CONFIG_NET_DSA_TAG_YT921X_8021Q)
++		case DSA_TAG_PROTO_YT921X_8021Q:
++			*tagged = true;
++			*vid = yt921x_8021q_tx_vid(dp->index);
++			break;
++#endif
++		default:
++			return -EOPNOTSUPP;
++		}
++
++		dev = dsa_port_to_conduit(dp);
++	}
++#endif
++
++	if (!edma_port_is_edma_netdev(dev))
++		return -EOPNOTSUPP;
++
++	port_priv = netdev_priv(dev);
++
++	return port_priv->ppe_port->port_id;
++}
++
++struct ppe_flow_data {
++	int in_port;
++	/* Addresses of the ingress device and of its bridge */
++	u8 in_addrs[2][ETH_ALEN];
++	u8 h_dest[ETH_ALEN];
++	u8 h_source[ETH_ALEN];
++	__be32 saddr, daddr;
++	__be32 new_saddr, new_daddr;
++	__be16 sport, dport;
++	__be16 new_sport, new_dport;
++	u8 l4proto;
++};
++
++static void ppe_flow_mangle_eth(const struct flow_action_entry *act,
++				struct ppe_flow_data *data)
++{
++	u8 eth[ETH_ALEN * 2];
++	const void *src = &act->mangle.val;
++	void *dest;
++
++	if (act->mangle.offset > 8)
++		return;
++
++	memcpy(eth, data->h_dest, ETH_ALEN);
++	memcpy(eth + ETH_ALEN, data->h_source, ETH_ALEN);
++	dest = eth + act->mangle.offset;
++
++	if (act->mangle.mask == 0xffff) {
++		src += 2;
++		dest += 2;
++	}
++
++	memcpy(dest, src, act->mangle.mask ? 2 : 4);
++	memcpy(data->h_dest, eth, ETH_ALEN);
++	memcpy(data->h_source, eth + ETH_ALEN, ETH_ALEN);
++}
++
++static int ppe_flow_mangle_ports(const struct flow_action_entry *act,
++				 struct ppe_flow_data *data)
++{
++	u32 val = ntohl(act->mangle.val);
++
++	switch (act->mangle.offset) {
++	case 0:
++		if (act->mangle.mask == ~htonl(0xffff))
++			data->new_dport = cpu_to_be16(val);
++		else
++			data->new_sport = cpu_to_be16(val >> 16);
++		break;
++	case 2:
++		data->new_dport = cpu_to_be16(val);
++		break;
++	default:
++		return -EINVAL;
++	}
++
++	return 0;
++}
++
++static int ppe_flow_mangle_ipv4(const struct flow_action_entry *act,
++				struct ppe_flow_data *data)
++{
++	switch (act->mangle.offset) {
++	case offsetof(struct iphdr, saddr):
++		data->new_saddr = (__force __be32)act->mangle.val;
++		break;
++	case offsetof(struct iphdr, daddr):
++		data->new_daddr = (__force __be32)act->mangle.val;
++		break;
++	default:
++		return -EINVAL;
++	}
++
++	return 0;
++}
++
++/* Take the IPv4 TCP/UDP tuple and the ingress PPE port from the match. */
++static int ppe_flow_parse_match(struct flow_cls_offload *f,
++				struct ppe_flow_data *data)
++{
++	struct flow_rule *rule = flow_cls_offload_flow_rule(f);
++	struct flow_match_ipv4_addrs addrs;
++	struct net_device *idev, *upper;
++	struct flow_match_control control;
++	struct flow_match_basic basic;
++	struct flow_match_ports ports;
++	struct flow_match_meta meta;
++	bool tagged;
++	u16 vid;
++
++	if (!flow_rule_match_key(rule, FLOW_DISSECTOR_KEY_META) ||
++	    !flow_rule_match_key(rule, FLOW_DISSECTOR_KEY_CONTROL) ||
++	    !flow_rule_match_key(rule, FLOW_DISSECTOR_KEY_BASIC) ||
++	    !flow_rule_match_key(rule, FLOW_DISSECTOR_KEY_IPV4_ADDRS) ||
++	    !flow_rule_match_key(rule, FLOW_DISSECTOR_KEY_PORTS))
++		return -EOPNOTSUPP;
++
++	if (flow_rule_match_key(rule, FLOW_DISSECTOR_KEY_VLAN) ||
++	    flow_rule_match_key(rule, FLOW_DISSECTOR_KEY_CVLAN))
++		return -EOPNOTSUPP;
++
++	flow_rule_match_control(rule, &control);
++	if (control.key->addr_type != FLOW_DISSECTOR_KEY_IPV4_ADDRS ||
++	    flow_rule_has_control_flags(control.mask->flags, f->common.extack))
++		return -EOPNOTSUPP;
++
++	flow_rule_match_basic(rule, &basic);
++	data->l4proto = basic.key->ip_proto;
++	if (data->l4proto != IPPROTO_TCP && data->l4proto != IPPROTO_UDP)
++		return -EOPNOTSUPP;
++
++	flow_rule_match_ipv4_addrs(rule, &addrs);
++	data->saddr = addrs.key->src;
++	data->daddr = addrs.key->dst;
++
++	flow_rule_match_ports(rule, &ports);
++	data->sport = ports.key->src;
++	data->dport = ports.key->dst;
++
++	flow_rule_match_meta(rule, &meta);
++
++	rcu_read_lock();
++	idev = dev_get_by_index_rcu(&init_net, meta.key->ingress_ifindex);
++	if (!idev) {
++		rcu_read_unlock();
++		return -ENODEV;
++	}
++
++	data->in_port = ppe_flow_dev_port(idev, &tagged, &vid);
++	ether_addr_copy(data->in_addrs[0], idev->dev_addr);
++	upper = netdev_master_upper_dev_get_rcu(idev);
++	if (upper)
++		ether_addr_copy(data->in_addrs[1], upper->dev_addr);
++	rcu_read_unlock();
++
++	return data->in_port < 0 ? data->in_port : 0;
++}
++
++static void ppe_flow_entry_release(struct ppe_flow *flow,
++				   struct ppe_flow_entry *entry)
++{
++	int i;
++
++	if (entry->nh)
++		ppe_flow_nexthop_put(flow, entry->nh);
++
++	if (entry->host)
++		ppe_flow_host_put(flow, entry->host);
++
++	for (i = 0; i < entry->num_mac_slots; i++)
++		ppe_flow_mac_put(flow, entry->mac_slots[i]);
++}
++
++static int ppe_flow_entry_hold_mac(struct ppe_flow *flow,
++				   struct ppe_flow_entry *entry, const u8 *addr)
++{
++	int slot;
++
++	if (!is_valid_ether_addr(addr))
++		return 0;
++
++	slot = ppe_flow_mac_get(flow, addr);
++	if (slot < 0)
++		return slot;
++
++	entry->mac_slots[entry->num_mac_slots++] = slot;
++
++	return slot;
++}
++
++static int ppe_flow_replace(struct ppe_flow *flow, struct flow_cls_offload *f)
++{
++	struct flow_rule *rule = flow_cls_offload_flow_rule(f);
++	struct ppe_flow_nexthop nh_key = { .pub_ip = -1 };
++	u32 buf[PPE_FLOW_ENTRY_WORDS] = {};
++	struct net_device *odev = NULL;
++	struct ppe_flow_data data = {};
++	struct ppe_flow_entry *entry;
++	struct flow_action_entry *act;
++	int out_port, ret, i;
++	u32 proto;
++
++	if (rhashtable_lookup_fast(&flow->entries, &f->cookie, ppe_flow_ht_params))
++		return -EEXIST;
++
++	ret = ppe_flow_parse_match(f, &data);
++	if (ret)
++		return ret;
++
++	proto = data.l4proto == IPPROTO_TCP ? PPE_FLOW_PROTO_TCP :
++					      PPE_FLOW_PROTO_UDP;
++	data.new_saddr = data.saddr;
++	data.new_daddr = data.daddr;
++	data.new_sport = data.sport;
++	data.new_dport = data.dport;
++
++	flow_action_for_each(i, act, &rule->action) {
++		switch (act->id) {
++		case FLOW_ACTION_MANGLE:
++			switch (act->mangle.htype) {
++			case FLOW_ACT_MANGLE_HDR_TYPE_ETH:
++				ppe_flow_mangle_eth(act, &data);
++				ret = 0;
++				break;
++			case FLOW_ACT_MANGLE_HDR_TYPE_IP4:
++				ret = ppe_flow_mangle_ipv4(act, &data);
++				break;
++			case FLOW_ACT_MANGLE_HDR_TYPE_TCP:
++			case FLOW_ACT_MANGLE_HDR_TYPE_UDP:
++				ret = ppe_flow_mangle_ports(act, &data);
++				break;
++			default:
++				ret = -EOPNOTSUPP;
++				break;
++			}
++			if (ret)
++				return ret;
++			break;
++		case FLOW_ACTION_REDIRECT:
++			odev = act->dev;
++			break;
++		case FLOW_ACTION_CSUM:
++			break;
++		default:
++			/* VLAN and PPPoE encapsulation are not handled yet. */
++			return -EOPNOTSUPP;
++		}
++	}
++
++	if (!odev || !is_valid_ether_addr(data.h_source) ||
++	    !is_valid_ether_addr(data.h_dest))
++		return -EOPNOTSUPP;
++
++	out_port = ppe_flow_dev_port(odev, &nh_key.tagged, &nh_key.cvid);
++	if (out_port < 0)
++		return out_port;
++
++	entry = kzalloc(sizeof(*entry), GFP_KERNEL);
++	if (!entry)
++		return -ENOMEM;
++
++	entry->cookie = f->cookie;
++	entry->in_port = data.in_port;
++	entry->saddr = data.saddr;
++	entry->daddr = data.daddr;
