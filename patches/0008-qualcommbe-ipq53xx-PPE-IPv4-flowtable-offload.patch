++	entry = rhashtable_lookup_fast(&flow->entries, &f->cookie,
++				       ppe_flow_ht_params);
++	if (!entry)
++		return -ENOENT;
++
++	ppe_flow_entry_destroy(flow, entry);
++
++	return 0;
