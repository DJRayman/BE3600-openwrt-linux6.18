++static void ppe_flow_flush(struct ppe_flow *flow)
++{
++	struct ppe_flow_entry *entry, *tmp;
++	int port;
++
++	list_for_each_entry_safe(entry, tmp, &flow->entry_list, list)
++		ppe_flow_entry_destroy(flow, entry);
++
++	for_each_set_bit(port, &flow->in_ports, BITS_PER_LONG)
++		ppe_flow_in_port_disable(flow, port);
++}
