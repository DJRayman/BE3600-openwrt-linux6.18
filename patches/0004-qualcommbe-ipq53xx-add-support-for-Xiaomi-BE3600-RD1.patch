diff --git a/target/linux/qualcommbe/dts/ipq5332-xiaomi-rd16.dts b/target/linux/qualcommbe/dts/ipq5332-xiaomi-rd16.dts
new file mode 100644
index 0000000000..5a1ce0a14a
--- /dev/null
+++ b/target/linux/qualcommbe/dts/ipq5332-xiaomi-rd16.dts
@@ -0,0 +1,540 @@
+// SPDX-License-Identifier: (GPL-2.0+ OR BSD-3-Clause)
+/*
+ * Xiaomi Router BE3600 (RD16)
+ *
+ * IPQ5312 (IPQ5332 family) / AP-MI04.1-C2, same reference board as the
+ * GL.iNet GL-BE3600, but the low-memory variant:
+ * - 256 MiB DDR (Linux sees ~192 MiB), 128 MiB parallel NAND (2k/128k),
+ *   partitions from SMEM, A/B system slots "rootfs" / "rootfs_1".
+ * - Ethernet: no discrete PHY. PPE port 2 (uniphy1) runs 2500base-x
+ *   (QSDK "SGMII_PLUS", forced 2500/full) into a Motorcomm YT9215S switch,
+ *   SMI address 0x1d on the IPQ MDIO bus, hardware reset on GPIO51.
+ *   Front ports: switch ports 0..2 = LAN4/LAN1/LAN2, port 3 = WAN.
+ *   PPE port 1 (uniphy0) is unpopulated on RD16 (RD15 has a 2.5G PHY there).
+ * - Wi-Fi: on-SoC 2.4 GHz (board-id 0x13) + QCN6432 5 GHz as Q6 user PD 2
+ *   (board-id 0x60). Stock "low-mem" Q6 memory map below.
+ *   Calibration lives in "0:art" at the stock ftm.conf AP-MI04.1-C2
+ *   offsets (IPQ5332 0x1000/0x11800, QCN6432 0x12800/0x1b800), same
+ *   layout as GL-BE3600; extracted by hotplug 12-ath12k-caldata.
+ * - LEDs: PWM RGB (blue = pwm ch2 / gpio30, orange = pwm ch1 / gpio31).
+ * - Buttons: reset GPIO43, mesh/WPS GPIO35 (both active low).
+ *
+ * All facts are taken from the stock QSDK 5.4 DTB and the stock boot log.
+ *
+ * Status: boots from slot A (UBI + squashfs), YT9215S via the yt921x DSA
+ * driver (wan, lan1, lan2, lan3). Wi-Fi: stock RD16 Q6 firmware (installed
+ * into files/ by stock-wifi-fw.py of the build project) in the 256 MiB memory mode,
+ * stock boot-args. Both radios verified on hardware (stock WLAN.WBE.1.3.r4
+ * in mode 2): 2.4 GHz HE20, 5 GHz HE80 ~600 Mbit/s TCP.
+ */
+
+/dts-v1/;
+
+#include <arm64/qcom/ipq5332.dtsi>
+
+#include <dt-bindings/gpio/gpio.h>
+#include <dt-bindings/input/input.h>
+#include <dt-bindings/leds/common.h>
+#include <dt-bindings/clock/qcom,ipq5332-nsscc.h>
+
+/ {
+	#address-cells = <0x2>;
+	#size-cells = <0x2>;
+	model = "Xiaomi Router BE3600 (RD16)";
+	compatible = "xiaomi,rd16", "qcom,ipq5332";
+
+	aliases {
+		serial0 = &blsp1_uart0;
+		led-boot = &led_status_blue;
+		led-failsafe = &led_status_orange;
+		led-running = &led_status_blue;
+		led-upgrade = &led_status_orange;
+		label-mac-device = &cpu_port;
+	};
+
+	chosen {
+		stdout-path = "serial0:115200n8";
+		/* Stock U-Boot (bootmiwifi) passes
+		 * "ubi.mtd=rootfs root=mtd:ubi_rootfs rootfstype=squashfs";
+		 * ubi.mtd attaches slot A, the appended root= (last one wins)
+		 * points at the OpenWrt "rootfs" volume (vol 1).
+		 * clk_ignore_unused: as stock, the late clk-disable pass kills
+		 * U-Boot-enabled buses on this platform.
+		 */
+		bootargs-append = " root=/dev/ubiblock0_1 clk_ignore_unused";
+	};
+
+	reserved-memory {
+		#address-cells = <2>;
+		#size-cells = <2>;
+		ranges;
+
+		/* No tzapp region: the stock tzapp@49B00000 node has no reg (U-Boot
+		 * does not fix it up either), so stock Linux uses that RAM, and
+		 * TZ apps are only loaded there via QSEECOM, which is not built.
+		 */
+
+		/* The dtsi reserves 4 MiB at 0x4a100000 for the bootloader; the
+		 * stock RD16 DTB only reserves uboot@4A300000 (2 MiB), so stock
+		 * Linux uses 0x4a100000..0x4a300000 as RAM. Give those 2 MiB back.
+		 */
+		/delete-node/ bootloader@4a100000;
+
+		uboot@4a300000 {
+			reg = <0x0 0x4a300000 0x0 0x200000>;
+			no-map;
+		};
+
+		/* Stock low-mem Q6 map (q6_mem_regions 0x4a900000..0x4e000000):
+		 *   0x4a900000 +0x1400000  Q6 root PD code + data  (q6_code_data)
+		 *   0x4bd00000 +0x0f00000  PD1 (IPQ5332 2.4G) data, BDF at start
+		 *                          (also holds both iu_fw images)
+		 *   0x4cc00000 +0x0100000  m3 dump
+		 *   0x4cd00000 +0x0100000  etr dump
+		 *   0x4ce00000 +0x1000000  PD2 (QCN6432 5G) data, BDF at start
+		 *   0x4de00000 +0x0100000  m3 dump QCN6432
+		 *   0x4df00000 +0x0100000  etr QCN6432
+		 *   0x4e000000 +0x0700000  MLO global memory
+		 *   0x4e700000 +0x0080000  rsvd1
+		 * Stock has no separate caldb region (cold-boot calibration off);
+		 * its PD1 caldb-addr points at 0x4ce00000.
+		 * q6_region (below) spans root PD code + PD1 data in one piece:
+		 * the iu_fw images are linked at 0x4bd40000 (IPQ5332) and
+		 * 0x4bd94000 (QCN6432), and ath12k loads every MDT relative to
+		 * "q6-region" ("segment outside memory range" otherwise).
+		 */
+
+		m3_dump: m3-dump@4cc00000 {
+			reg = <0x0 0x4cc00000 0x0 0x100000>;
+			no-map;
+		};
+
+		q6_etr: q6-etr-dump@4cd00000 {
+			reg = <0x0 0x4cd00000 0x0 0x100000>;
+			no-map;
+		};
+
+		q6_qcn6432_data: q6-qcn6432-data@4ce00000 {
+			reg = <0x0 0x4ce00000 0x0 0x1000000>;
+			no-map;
+		};
+
+		m3_dump_qcn6432: m3-dump-qcn6432@4de00000 {
+			reg = <0x0 0x4de00000 0x0 0x100000>;
+			no-map;
+		};
+
+		q6_qcn6432_etr: q6-qcn6432-etr@4df00000 {
+			reg = <0x0 0x4df00000 0x0 0x100000>;
+			no-map;
+		};
+
+		mlo_mem: mlo-global-mem@4e000000 {
+			reg = <0x0 0x4e000000 0x0 0x0700000>;
+			no-map;
+		};
+
+		rsvd1: rsvd1@4e700000 {
+			reg = <0x0 0x4e700000 0x0 0x0080000>;
+			no-map;
+		};
+
+		/* Crash log that survives a warm reset; read from /sys/fs/pstore. */
+		ramoops@4e780000 {
+			compatible = "ramoops";
+			reg = <0x0 0x4e780000 0x0 0x80000>;
+			record-size = <0x20000>;
+			console-size = <0x40000>;
+			pmsg-size = <0>;
+			ecc-size = <0>;
+		};
+	};
+
+	soc@0 {
+		/* QCN6432 5 GHz radio: Q6 user PD 2 (ath12k hybrid-bus patch).
+		 * Caldata: "0:art" 0x12800, region 0x1b800 (block 0x18800 on the
+		 * test unit), stock ftm.conf "ap-mi04.1-c2,0060,1,75776,112640".
+		 */
+		wifi1: wifi-qcn6432 {
+			compatible = "qcom,qcn6432-wifi";
+			msi-parent = <&v2m0>;
+			interrupts-extended = <&smp2p_wcss_in 16 IRQ_TYPE_NONE>,
+					      <&smp2p_wcss_in 17 IRQ_TYPE_NONE>,
+					      <&smp2p_wcss_in 20 IRQ_TYPE_NONE>,
+					      <&smp2p_wcss_in 19 IRQ_TYPE_NONE>;
+			interrupt-names = "fatal",
+					  "ready",
+					  "spawn",
+					  "stop-ack";
+			qcom,smem-states = <&smp2p_wcss_out 16>,
+					   <&smp2p_wcss_out 17>,
+					   <&smp2p_wcss_out 18>;
+			qcom,smem-state-names = "shutdown",
+						"stop",
+						"spawn";
+			firmware-name = "ath12k/QCN6432/hw1.0/q6_fw2.mdt",
+					"ath12k/QCN6432/hw1.0/iu_fw.mdt";
+			memory-region = <&q6_region>, <&m3_dump_qcn6432>,
+					<&q6_qcn6432_data>, <&mlo_mem>,
+					<&q6_qcn6432_data>;
+			memory-region-names = "q6-region", "m3-dump", "q6-caldb",
+					      "mlo-global-mem", "host-ddr-mem";
+			qcom,bdf-address-offset = <0>;
+			qcom,board-id = <0x60>;
+			/* QSDK "qcom,tgt-mem-mode = <2>": 256 MiB firmware profile */
+			qcom,ath12k-fw-memory-mode = <2>;
+			qcom,legacy-userpd-bootinfo;
+			qcom,rproc = <&q6v5_wcss>;
+			status = "okay";
+		};
+
+		gpio_keys {
+			compatible = "gpio-keys";
+			pinctrl-0 = <&button_pins>;
+			pinctrl-names = "default";
+
+			reset {
+				label = "reset";
+				linux,code = <KEY_RESTART>;
+				gpios = <&tlmm 43 GPIO_ACTIVE_LOW>;
+				debounce-interval = <60>;
+			};
+
+			wps {
+				label = "mesh";
+				linux,code = <KEY_WPS_BUTTON>;
+				gpios = <&tlmm 35 GPIO_ACTIVE_LOW>;
+				debounce-interval = <60>;
+			};
+		};
+
+		leds {
+			compatible = "pwm-leds";
+
+			led_status_blue: led-0 {
+				color = <LED_COLOR_ID_BLUE>;
+				function = LED_FUNCTION_STATUS;
+				pwms = <&pwm 2 50000>;
+				max-brightness = <255>;
+			};
+
+			led_status_orange: led-1 {
+				color = <LED_COLOR_ID_ORANGE>;
+				function = LED_FUNCTION_STATUS;
+				pwms = <&pwm 1 50000>;
+				max-brightness = <255>;
+			};
+		};
+	};
+};
+
+&blsp1_uart0 {
+	pinctrl-0 = <&serial_0_pins>;
+	pinctrl-names = "default";
+	status = "okay";
+};
+
+&pwm {
+	#pwm-cells = <2>;
+	pinctrl-0 = <&pwm_pins>;
+	pinctrl-names = "default";
+	status = "okay";
+};
+
+&tlmm {
+	/* QSPI serial NAND (Winbond W25N01KW, 1.8 V), as stock */
+	qspi_nand_pins: qspi-nand-state {
+		qspi-clock-pins {
+			pins = "gpio13";
+			function = "qspi_clk";
+			drive-strength = <8>;
+			bias-disable;
+		};
+
+		qspi-cs-pins {
+			pins = "gpio12";
+			function = "qspi_cs";
+			drive-strength = <8>;
+			bias-disable;
+		};
+
+		qspi-data-pins {
+			pins = "gpio8", "gpio9", "gpio10", "gpio11";
+			function = "qspi_data";
+			drive-strength = <8>;
+			bias-disable;
+		};
+	};
+
+	switch_reset_pins: switch-reset-state {
+		pins = "gpio51";
+		function = "gpio";
+		drive-strength = <8>;
+		bias-disable;
+	};
+
+	button_pins: button-state {
+		pins = "gpio35", "gpio43";
+		function = "gpio";
+		drive-strength = <8>;
+		bias-pull-up;
+	};
+
+	/* Stock: orange = pwm ch1 (gpio31), blue = ch2 (gpio30). Upstream
+	 * pinctrl names the mux function after the pin bank (gpio29..32 =
+	 * "pwm1"), not the channel as QSDK did.
+	 */
+	pwm_pins: pwm-state {
+		pins = "gpio30", "gpio31";
+		function = "pwm1";
+		drive-strength = <8>;
+	};
+};
+
+/* Stock MDIO uses both pin groups (mdio1 gpio27/28 + mdio0 gpio25/26), as
+ * the dtsi default. GPIO51 is the YT9215S hardware reset (stock mdio node:
+ * phy-reset-gpio = <&tlmm 51 0>, driven high to run). After a normal
+ * boot U-Boot leaves it an input, low (switch in reset); the yt921x
+ * driver pulses it (the MDIO core only drives reset-gpios for PHYs).
+ */
+&mdio {
+	status = "okay";
+
+	/* Motorcomm YT9215S, SMI 0x1d. Front ports, left to right as seen
+	 * from the back (verified by plugging a cable into each):
+	 *   1 = PHY 3 (WAN), 2 = PHY 2, 3 = PHY 1, 4 = PHY 0; PHY 4 unused.
+	 * Named wan, lan1, lan2, lan3 in that order (the stock Xiaomi port
+	 * map called them WAN, LAN2, LAN1, LAN4). CPU: GMAC 8, 2.5G SerDes
+	 * to PPE port 2.
+	 */
+	switch@1d {
+		compatible = "motorcomm,yt9215";
+		reg = <0x1d>;
+		reset-gpios = <&tlmm 51 GPIO_ACTIVE_LOW>;
+		pinctrl-0 = <&switch_reset_pins>;
+		pinctrl-names = "default";
+
+		mdio {
+			#address-cells = <1>;
+			#size-cells = <0>;
+
+			sw_phy0: phy@0 {
+				reg = <0x0>;
+			};
+
+			sw_phy1: phy@1 {
+				reg = <0x1>;
+			};
+
+			sw_phy2: phy@2 {
+				reg = <0x2>;
+			};
+
+			sw_phy3: phy@3 {
+				reg = <0x3>;
+			};
+		};
+
+		ethernet-ports {
+			#address-cells = <1>;
+			#size-cells = <0>;
+
+			ethernet-port@0 {
+				reg = <0>;
+				label = "lan3";
+				phy-mode = "internal";
+				phy-handle = <&sw_phy0>;
+			};
+
+			ethernet-port@1 {
+				reg = <1>;
+				label = "lan2";
+				phy-mode = "internal";
+				phy-handle = <&sw_phy1>;
+			};
+
+			ethernet-port@2 {
+				reg = <2>;
+				label = "lan1";
+				phy-mode = "internal";
+				phy-handle = <&sw_phy2>;
+			};
+
+			ethernet-port@3 {
+				reg = <3>;
+				label = "wan";
+				phy-mode = "internal";
+				phy-handle = <&sw_phy3>;
+				nvmem-cells = <&macaddr_uboot_ethaddr 1>;
+				nvmem-cell-names = "mac-address";
+			};
+
+			ethernet-port@8 {
+				reg = <8>;
+				phy-mode = "2500base-x";
+				ethernet = <&cpu_port>;
+
+				fixed-link {
+					speed = <2500>;
+					full-duplex;
+				};
+			};
+		};
+	};
+};
+
+&qcom_ppe {
+	status = "okay";
+
+	ethernet-ports {
+		#address-cells = <1>;
+		#size-cells = <0>;
+
+		/* DSA conduit into the YT9215S GMAC 8. Stock: PPE port 2,
+		 * uniphy1 in SGMII_PLUS, forced 2500 Mbit/s full duplex.
+		 */
+		cpu_port: port@2 {
+			reg = <2>;
+			phy-mode = "2500base-x";
+			label = "eth0";
+			pcs-handle = <&pcs1_ch0>;
+			/* LAN MAC = U-Boot "ethaddr" (a4:ba:70:..:68 on the test unit);
+			 * DSA LAN ports inherit it, WAN uses +1, radios +2/+3 (stock).
+			 */
+			nvmem-cells = <&macaddr_uboot_ethaddr 0>;
+			nvmem-cell-names = "mac-address";
+			clocks = <&nsscc NSS_CC_PORT2_MAC_CLK>,
+				 <&nsscc NSS_CC_PORT2_RX_CLK>,
+				 <&nsscc NSS_CC_PORT2_TX_CLK>;
+			clock-names = "mac",
+				      "rx",
+				      "tx";
+			resets = <&nsscc NSS_CC_PORT2_MAC_CLK_ARES>,
+				 <&nsscc NSS_CC_PORT2_RX_CLK_ARES>,
+				 <&nsscc NSS_CC_PORT2_TX_CLK_ARES>;
+			reset-names = "mac",
+				      "rx",
+				      "tx";
+
+			fixed-link {
+				speed = <2500>;
+				full-duplex;
+			};
+		};
+	};
+};
+
+&pcs1 {
+	status = "okay";
+};
+
+&qpic_nand {
+	pinctrl-0 = <&qspi_nand_pins>;
+	pinctrl-names = "default";
+	status = "okay";
+
+	flash@0 {
+		compatible = "spi-nand";
+		reg = <0>;
+		#address-cells = <1>;
+		#size-cells = <1>;
+		nand-ecc-engine = <&qpic_nand>;
+		nand-ecc-strength = <4>;
+		nand-ecc-step-size = <512>;
+
+		partitions {
+			compatible = "qcom,smem-part";
+
+			/* U-Boot env: also written by fw_setenv, so not read-only */
+			partition-0-appsblenv {
+				label = "0:appsblenv";
+
+				nvmem-layout {
+					compatible = "u-boot,env";
+					env-size = <0x10000>;
+
+					macaddr_uboot_ethaddr: ethaddr {
+						#nvmem-cell-cells = <1>;
+					};
+				};
+			};
+
+			/* Wi-Fi caldata source (read by 12-ath12k-caldata) */
+			partition-0-art {
+				label = "0:art";
+				read-only;
+			};
+
+			/* Slot A "rootfs" is the only system slot OpenWrt owns;
+			 * slot B ("rootfs_1") keeps the stock firmware. Neither is
+			 * auto-attached during bring-up: with the QPIC host ECC,
+			 * slot A's QSDK-written UBI reads back with ECC errors
+			 * (-74) - under investigation (on-die vs host ECC layout).
+			 */
+
+			partition-bdata {
+				label = "bdata";
+				read-only;
+			};
+		};
+	};
+};
+
+&qpic_bam {
+	status = "okay";
+};
+
+&ref_48mhz_clk {
+	clock-div = <1>;
+	clock-mult = <1>;
+};
+
+&sleep_clk {
+	clock-frequency = <32000>;
+};
+
+&xo_board {
+	clock-div = <2>;
+	clock-mult = <1>;
+};
+
+&xo_clk {
+	clock-frequency = <48000000>;
+};
+
+/* Root PD code + data (stock q6_code_data 0x4a900000 + 0x1400000) plus
+ * PD1 data (stock q6_ipq5332_data 0x4bd00000 + 0xf00000): q6_fw0/1/2 and
+ * both iu_fw images must all load inside this one region.
+ */
+&q6_region {
+	reg = <0x0 0x4a900000 0x0 0x2300000>;
+};
+
+/* Integrated 2.4 GHz radio (Q6 user PD 1).
+ * Caldata: "0:art" 0x1000, region 0x11800 (block 0xf800 on the test
+ * unit), stock ftm.conf "ap-mi04.1-c2,13,0,4096,71680".
+ */
+&wifi0 {
+	firmware-name = "ath12k/IPQ5332/hw1.0/q6_fw1.mdt",
+			"ath12k/IPQ5332/hw1.0/iu_fw.mdt";
+	memory-region = <&q6_region>, <&m3_dump>, <&q6_qcn6432_data>, <&mlo_mem>;
+	memory-region-names = "q6-region", "m3-dump", "q6-caldb", "mlo-global-mem";
+	/* PD1 board data at 0x4bd00000 = q6_region + 0x1400000 (stock bdf-addr) */
+	qcom,bdf-address-offset = <0x1400000>;
+	qcom,board-id = <0x13>;
+	/* QSDK "qcom,tgt-mem-mode = <2>": 256 MiB firmware profile */
+	qcom,ath12k-fw-memory-mode = <2>;
+	qcom,legacy-userpd-bootinfo;
+	qcom,rproc = <&q6v5_wcss>;
+	status = "okay";
+};
+
+&q6v5_wcss {
+	firmware-name = "ath12k/IPQ5332/hw1.0/q6_fw0.mdt";
+	/* Stock RD16 boot-args record (QSDK bootargs version 2, SMEM 0x1fb):
+	 * type 1, length 4, payload 3 1 0x2f 2. The GL-BE3600 record
+	 * (length 5) made the RD16 firmware assert "err_smem_ver.2.1".
+	 */
+	boot-args = <1 4 3 1 0x2f 2>;
+	status = "okay";
+};
