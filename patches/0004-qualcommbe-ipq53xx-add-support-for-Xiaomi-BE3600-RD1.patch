diff --git a/target/linux/qualcommbe/ipq53xx/base-files/etc/hotplug.d/ieee80211/12-rd16-wifi b/target/linux/qualcommbe/ipq53xx/base-files/etc/hotplug.d/ieee80211/12-rd16-wifi
new file mode 100755
index 0000000000..b3f77b3fcc
--- /dev/null
+++ b/target/linux/qualcommbe/ipq53xx/base-files/etc/hotplug.d/ieee80211/12-rd16-wifi
@@ -0,0 +1,42 @@
+#!/bin/sh
+# Xiaomi RD16: fix up the radios 10-wifi-detect just generated.
+#
+# The Q6 firmware's own regulatory table (the radios are self-managed)
+# forbids EHT for RU, and caps 5170-5330 MHz at 80 MHz; channels 100-144
+# are not usable for RU clients either. wifi-detect picks EHT and "auto",
+# so the APs would fail with "Failed to set beacon parameters". Switch
+# RU radios to HE and pin 5 GHz to channel 36 (no DFS, starts at once).
+
+[ "$ACTION" = "add" ] || exit 0
+. /lib/functions.sh
+[ "$(board_name)" = "xiaomi,rd16" ] || exit 0
+
+# mac80211 lets the 5 GHz phy queue up to 16 MiB of frames (2.4 GHz: 4 MiB).
+# With ath12k's TX flow control the frames wait there, and 16 MiB is most of
+# what this board has free; use the 2.4 GHz default of 4 MiB for both.
+aqm="/sys/kernel/debug/ieee80211/$DEVICENAME/aqm"
+grep -q debugfs /proc/mounts || mount -t debugfs none /sys/kernel/debug 2>/dev/null
+for i in 1 2 3 4 5; do [ -w "$aqm" ] && break; sleep 1; done
+[ -w "$aqm" ] && echo "fq_memory_limit 4194304" > "$aqm"
+
+changed=
+fix_radio() {
+	local s="$1" country htmode band
+	config_get country "$s" country
+	config_get htmode "$s" htmode
+	config_get band "$s" band
+	[ "$country" = "RU" ] || return 0
+	case "$htmode" in EHT*) ;; *) return 0 ;; esac
+
+	uci set "wireless.$s.htmode=HE${htmode#EHT}"
+	[ "$band" = "5g" ] && uci set "wireless.$s.channel=36"
+	changed=1
+}
+
+config_load wireless
+config_foreach fix_radio wifi-device
+[ -n "$changed" ] || exit 0
+uci commit wireless
+ubus call network reload 2>/dev/null
+ubus call network.wireless retry 2>/dev/null
+exit 0
diff --git a/target/linux/qualcommbe/ipq53xx/base-files/etc/init.d/rd16-mem b/target/linux/qualcommbe/ipq53xx/base-files/etc/init.d/rd16-mem
new file mode 100755
index 0000000000..b96a9832d0
--- /dev/null
+++ b/target/linux/qualcommbe/ipq53xx/base-files/etc/init.d/rd16-mem
@@ -0,0 +1,12 @@
+#!/bin/sh /etc/rc.common
+# Xiaomi RD16: Linux only gets ~160 MiB of the 256 MiB (Q6/TZ carve-outs),
+# and ath12k pins most of it. The generic 16 MiB min_free_kbytes reserve
+# (meant for >128 MiB boards) then leaves almost nothing to userspace.
+
+START=12
+
+boot() {
+	case "$(board_name)" in
+	xiaomi,rd16) sysctl -qw vm.min_free_kbytes=8192 ;;
+	esac
+}
diff --git a/target/linux/qualcommbe/ipq53xx/base-files/etc/init.d/xiaomi-bootok b/target/linux/qualcommbe/ipq53xx/base-files/etc/init.d/xiaomi-bootok
new file mode 100755
index 0000000000..665064bd0b
--- /dev/null
+++ b/target/linux/qualcommbe/ipq53xx/base-files/etc/init.d/xiaomi-bootok
@@ -0,0 +1,26 @@
+#!/bin/sh /etc/rc.common
+# Xiaomi RD16: tell the stock U-Boot (bootmiwifi) that system slot A booted.
+# Stock firmware resets the boot-failure counter after every good boot; if
+# nobody does, U-Boot keeps counting flag_try_sys1_failed up and may fall back
+# to slot B (stock) on its own.
+
+START=99
+
+boot() {
+	case "$(board_name)" in
+	xiaomi,rd16) ;;
+	*) return 0 ;;
+	esac
+
+	command -v fw_printenv >/dev/null || return 0
+	[ "$(fw_printenv -n flag_boot_rootfs 2>/dev/null)" = "0" ] || return 0
+
+	[ "$(fw_printenv -n flag_try_sys1_failed 2>/dev/null)" = "0" ] &&
+	[ "$(fw_printenv -n flag_boot_success 2>/dev/null)" = "1" ] &&
+	[ "$(fw_printenv -n flag_last_success 2>/dev/null)" = "0" ] && return 0
+
+	fw_setenv flag_try_sys1_failed 0
+	fw_setenv flag_boot_success 1
+	fw_setenv flag_last_success 0
+	logger -t xiaomi-bootok "reset U-Boot slot A boot counter"
+}
diff --git a/target/linux/qualcommbe/ipq53xx/base-files/lib/preinit/79_rd16_initramfs_nowifi b/target/linux/qualcommbe/ipq53xx/base-files/lib/preinit/79_rd16_initramfs_nowifi
new file mode 100644
index 0000000000..087f85df4c
--- /dev/null
+++ b/target/linux/qualcommbe/ipq53xx/base-files/lib/preinit/79_rd16_initramfs_nowifi
@@ -0,0 +1,15 @@
+# Xiaomi RD16: the RAM-boot (initramfs) image is the recovery/flashing tool.
+# Its rootfs already lives in RAM, and with ath12k loaded there is no room
+# left to download a factory.ubi into /tmp. Do not load Wi-Fi there.
+# (preinit_main stops at 70_initramfs_test, so hook the "initramfs" chain.)
+
+rd16_initramfs_nowifi() {
+	case "$(board_name)" in
+	xiaomi,rd16) ;;
+	*) return 0 ;;
+	esac
+
+	rm -f /etc/modules.d/ath12k /etc/modules.d/*ath12k*
+}
+
+boot_hook_add initramfs rd16_initramfs_nowifi
diff --git a/target/linux/qualcommbe/ipq53xx/base-files/lib/preinit/81_rd16_rproc_coredump b/target/linux/qualcommbe/ipq53xx/base-files/lib/preinit/81_rd16_rproc_coredump
new file mode 100644
index 0000000000..80527b9065
--- /dev/null
+++ b/target/linux/qualcommbe/ipq53xx/base-files/lib/preinit/81_rd16_rproc_coredump
@@ -0,0 +1,17 @@
+# Xiaomi RD16 (256 MiB): never copy a Q6 WLAN firmware crash dump into RAM.
+# The remoteproc coredump of the Q6 regions (tens of MiB) runs the box out of
+# memory and panics it ("System is deadlocked on memory", seen on hardware).
+# Must happen before ath12k loads, so preinit rather than ieee80211 hotplug.
+
+rd16_rproc_coredump() {
+	case "$(board_name)" in
+	xiaomi,rd16) ;;
+	*) return 0 ;;
+	esac
+
+	for rproc in /sys/class/remoteproc/remoteproc*; do
+		[ -w "$rproc/coredump" ] && echo disabled > "$rproc/coredump"
+	done
+}
+
+boot_hook_add preinit_main rd16_rproc_coredump
diff --git a/target/linux/qualcommbe/ipq53xx/base-files/lib/upgrade/platform.sh b/target/linux/qualcommbe/ipq53xx/base-files/lib/upgrade/platform.sh
