@@ -1,5 +1,6 @@
 REQUIRE_IMAGE_METADATA=1
-RAMFS_COPY_BIN='dumpimage fitblk fit_check_sign'
+RAMFS_COPY_BIN='dumpimage fitblk fit_check_sign fw_printenv fw_setenv'
+RAMFS_COPY_DATA='/etc/fw_env.config'
 
 gl_be6500_remove_oem_rootfs() {
 	local mtdnum
@@ -43,6 +44,29 @@ gl_remove_oem_wifi_fw() {
 	}
 }
 
+# Xiaomi RD16: the stock U-Boot (bootmiwifi) boots system slot A ("rootfs",
+# the one OpenWrt lives in) while flag_boot_rootfs=0 and counts failed boots
+# in flag_try_sys1_failed. Point it at slot A with a clean counter before
+# rewriting it; slot B ("rootfs_1", stock firmware) is never touched and
+# stays the fallback if the new image does not boot.
+xiaomi_rd16_set_boot_slot_a() {
+	local script=/tmp/rd16-uboot-env
+
+	[ -s /etc/fw_env.config ] || {
+		echo "no /etc/fw_env.config, leaving the U-Boot boot flags alone"
+		return 0
+	}
+	mkdir -p /var/lock
+	: > "$script"
+	[ "$(fw_printenv -n flag_boot_rootfs 2>/dev/null)" = 0 ] ||
+		echo "flag_boot_rootfs 0" >> "$script"
+	[ "$(fw_printenv -n flag_try_sys1_failed 2>/dev/null)" = 0 ] ||
+		echo "flag_try_sys1_failed 0" >> "$script"
+	# one env write (one erase of 0:appsblenv) for all changes, if any
+	[ -s "$script" ] && fw_setenv -s "$script"
+	return 0
+}
+
 platform_do_upgrade() {
 	case "$(board_name)" in
 	gl.inet,gl-be3600)
@@ -65,6 +89,12 @@ platform_do_upgrade() {
 		CI_KERNPART="kernel0"
 		fit_do_upgrade "$1"
 		;;
+	xiaomi,rd16)
+		xiaomi_rd16_set_boot_slot_a
+		# slot A only: UBI volumes kernel / rootfs / rootfs_data on "rootfs"
+		CI_UBIPART="rootfs"
+		nand_do_upgrade "$1"
+		;;
 	*)
 		echo "Sysupgrade is not supported on your board yet."
 		return 1
@@ -107,6 +137,24 @@ platform_check_image() {
 	ubnt,u7-pro-xgs)
 		fit_check_image "$1"
 		;;
+	xiaomi,rd16)
+		# nand_do_platform_check also accepts a bare FIT or UBI image. A FIT
+		# (the initramfs .itb) would be written into the kernel volume only,
+		# and factory.ubi is meant for the TFTP/ubiformat path, so take the
+		# sysupgrade tar only.
+		case "$(get_magic_long "$1")" in
+		d00dfeed)
+			echo "This is a FIT (initramfs) image, use *-squashfs-sysupgrade.bin"
+			return 1
+			;;
+		55424923)
+			echo "This is factory.ubi, use *-squashfs-sysupgrade.bin"
+			echo "(or ubiformat /dev/mtd19 from the TFTP RAM-boot image)"
+			return 1
+			;;
+		esac
+		nand_do_platform_check "xiaomi_rd16" "$1"
+		;;
 	*)
 		echo "Sysupgrade is not supported on your board yet."
 		return 1
diff --git a/target/linux/qualcommbe/ipq53xx/base-files/usr/libexec/platform/packet-steering.sh b/target/linux/qualcommbe/ipq53xx/base-files/usr/libexec/platform/packet-steering.sh
index 05bad94878..cccbc3c3ad 100755
--- a/target/linux/qualcommbe/ipq53xx/base-files/usr/libexec/platform/packet-steering.sh
+++ b/target/linux/qualcommbe/ipq53xx/base-files/usr/libexec/platform/packet-steering.sh
@@ -28,4 +28,34 @@ for dev in /sys/class/net/*; do
 	esac
 done
 
+# Xiaomi RD16: the YT9215S hangs off one PPE port and all of its traffic
+# arrives on a single EDMA Rx ring (rxdesc_12, CPU0), so the assumption
+# above does not hold there: CPU0 saturated at ~500 Mbit/s of Wi-Fi.
+# Spread the PPE backlog over CPU1-3 and move the two busiest Wi-Fi
+# interrupts off CPU0/CPU3 (measured on hardware).
+. /lib/functions.sh
+[ "$(board_name)" = "xiaomi,rd16" ] || exit 0
+[ "$1" = "0" ] && exit 0
+
+for dev in /sys/class/net/*; do
+	[ -d "$dev/device" ] || continue
+	case "$(basename "$(readlink -f "$dev/device")")" in
+	*.ethernet)
+		for q in "$dev"/queues/rx-*; do
+			[ -f "$q/rps_cpus" ] || continue
+			echo e > "$q/rps_cpus"
+			echo 4096 > "$q/rps_flow_cnt"
+		done
+		;;
+	esac
+done
+echo 16384 > /proc/sys/net/core/rps_sock_flow_entries
+
+# QCN6432 DP group 2 (TX completions ring 2, monitor, REO status, RX refill)
+irq=$(awk '$6 ~ /wifi-qcn6432/ && $7 == 8 && $NF == "DP_EXT_IRQ" { sub(":", "", $1); print $1 }' /proc/interrupts)
+[ -n "$irq" ] && echo 1 > /proc/irq/$irq/smp_affinity_list
+# IPQ5332 (2.4 GHz) monitor destination ring
+irq=$(awk '$NF == "rxdma2host-monitor-destination-mac1" { sub(":", "", $1); print $1 }' /proc/interrupts)
+[ -n "$irq" ] && echo 3 > /proc/irq/$irq/smp_affinity_list
+
 exit 0
