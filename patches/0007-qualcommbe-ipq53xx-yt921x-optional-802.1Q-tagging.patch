++// SPDX-License-Identifier: GPL-2.0-or-later
++/*
++ * 802.1Q based tagging for Motorcomm YT921x switches.
++ *
++ * An alternative to the native 8-byte tag (EtherType 0x9988): the switch
++ * tags every frame it sends to the CPU with the RX VLAN of the ingress port,
++ * and the CPU addresses a port through that port's TX VLAN. The conduit then
++ * only ever sees standard 802.1Q frames, which its parser understands (L3/L4
++ * checksum offload, TSO, and packet processors that classify by VLAN).
++ *
++ * See include/linux/dsa/yt921x.h for the VLAN layout.
++ */
++
++#include <linux/dsa/yt921x.h>
++#include <linux/etherdevice.h>
++#include <linux/if_vlan.h>
++
++#include "tag.h"
++
++#define YT921X_8021Q_NAME	"yt921x-8021q"
++
++static struct sk_buff *
++yt921x_8021q_xmit(struct sk_buff *skb, struct net_device *netdev)
++{
++	struct dsa_port *dp = dsa_user_to_port(netdev);
++	u16 queue_mapping = skb_get_queue_mapping(skb);
++	u8 pcp = netdev_txq_to_tc(netdev, queue_mapping);
++	u16 tci;
++
++	tci = (pcp << VLAN_PRIO_SHIFT) | yt921x_8021q_tx_vid(dp->index);
++
++	/* skb->data points at the MAC header, which is fine for
++	 * vlan_insert_tag()
++	 */
++	return vlan_insert_tag(skb, htons(ETH_P_8021Q), tci);
++}
++
++static struct sk_buff *
++yt921x_8021q_rcv(struct sk_buff *skb, struct net_device *netdev)
++{
++	__be16 vlan_proto;
++	int port;
++	u16 tci;
++
++	if (skb_vlan_tag_present(skb)) {
++		/* The conduit stripped the tag for us */
++		vlan_proto = skb->vlan_proto;
++		tci = skb_vlan_tag_get(skb);
++	} else {
++		if (unlikely(!pskb_may_pull(skb, VLAN_HLEN)))
++			return NULL;
++
++		vlan_proto = vlan_eth_hdr(skb)->h_vlan_proto;
++		tci = ntohs(vlan_eth_hdr(skb)->h_vlan_TCI);
++	}
++
++	port = -1;
++	if (likely(vlan_proto == htons(ETH_P_8021Q)))
++		port = yt921x_8021q_rx_vid_to_port(tci & VLAN_VID_MASK);
++	if (unlikely(port < 0)) {
++		/* Frames the switch traps to the CPU (e.g. reserved
++		 * multicast) bypass egress tagging; nothing to do with them.
++		 */
++		if (!is_link_local_ether_addr(eth_hdr(skb)->h_dest))
++			dev_warn_ratelimited(&netdev->dev,
++					     "Unexpected frame (proto 0x%04x, VID %u)\n",
++					     ntohs(vlan_proto),
++					     tci & VLAN_VID_MASK);
++		return NULL;
++	}
++
++	skb->dev = dsa_conduit_find_user(netdev, 0, port);
++	if (unlikely(!skb->dev)) {
++		dev_warn_ratelimited(&netdev->dev,
++				     "Couldn't decode source port %d\n", port);
++		return NULL;
++	}
++
++	if (skb_vlan_tag_present(skb)) {
++		__vlan_hwaccel_clear_tag(skb);
++	} else {
++		skb_push_rcsum(skb, ETH_HLEN);
++		__skb_vlan_pop(skb, &tci);
++		skb_pull_rcsum(skb, ETH_HLEN);
++	}
++
++	/* Bridged ports are members of each other's RX VLAN, so the switch
++	 * has already flooded or forwarded this frame to them
++	 */
++	dsa_default_offload_fwd_mark(skb);
++
++	return skb;
++}
++
++static const struct dsa_device_ops yt921x_8021q_netdev_ops = {
++	.name			= YT921X_8021Q_NAME,
++	.proto			= DSA_TAG_PROTO_YT921X_8021Q,
++	.xmit			= yt921x_8021q_xmit,
++	.rcv			= yt921x_8021q_rcv,
++	.needed_headroom	= VLAN_HLEN,
++	.promisc_on_conduit	= true,
++};
