++/* SPDX-License-Identifier: GPL-2.0-or-later */
++/*
++ * VLAN layout shared by the Motorcomm YT921x switch driver and its 802.1Q
++ * based tagger (DSA_TAG_PROTO_YT921X_8021Q).
++ *
++ * Every user port owns two reserved VLANs:
++ *
++ *  - an RX VLAN (port PVID): frames entering the port are classified into it
++ *    and leave the CPU port tagged with it, so the tagger knows the precise
++ *    source port. Ports bridged together are members of each other's RX
++ *    VLANs, so traffic between them is switched in hardware.
++ *  - a TX VLAN: frames sent by the CPU carry it, and its only other member is
++ *    the port itself, so the CPU can always address one port.
++ */
++
++#ifndef _NET_DSA_YT921X_H
++#define _NET_DSA_YT921X_H
++
++#include <linux/types.h>
++
++#define YT921X_8021Q_PORT_NUM		11
++#define YT921X_8021Q_RX_VID_BASE	4001
++#define YT921X_8021Q_TX_VID_BASE	4017
++
++static inline u16 yt921x_8021q_rx_vid(int port)
++{
++	return YT921X_8021Q_RX_VID_BASE + port;
++}
++
++static inline u16 yt921x_8021q_tx_vid(int port)
++{
++	return YT921X_8021Q_TX_VID_BASE + port;
++}
++
++/* Returns the source port of an RX VLAN, or -1 for any other VID */
++static inline int yt921x_8021q_rx_vid_to_port(u16 vid)
++{
++	if (vid < YT921X_8021Q_RX_VID_BASE ||
++	    vid >= YT921X_8021Q_RX_VID_BASE + YT921X_8021Q_PORT_NUM)
++		return -1;
++
++	return vid - YT921X_8021Q_RX_VID_BASE;
++}
++
++static inline bool yt921x_8021q_vid_is_reserved(u16 vid)
++{
++	return vid >= YT921X_8021Q_RX_VID_BASE &&
++	       vid < YT921X_8021Q_TX_VID_BASE + YT921X_8021Q_PORT_NUM;
++}
++
++#endif
