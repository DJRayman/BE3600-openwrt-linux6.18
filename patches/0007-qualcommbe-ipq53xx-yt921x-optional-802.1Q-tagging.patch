From a3d8eae0b12a39a1144c48d9cd72c0bffa7a80c5 Mon Sep 17 00:00:00 2001
From: OpenWrt-Xiaomi-RD16-port <rd16@localhost>
Date: Thu, 22 Oct 2026 17:21:12 +0000
Subject: [PATCH] qualcommbe: ipq53xx: yt921x: optional 802.1Q tagging

- add the yt921x-8021q DSA tagger and the matching switch setup
  (patch 9114): ports are told apart by 802.1Q VLANs 4001+ (to the
  CPU) and 4017+ (from the CPU) instead of the 0x9988 header, ported
  from the RomikB/openwrt openwrt-24-rd15 driver; bridged ports still
  switch in hardware;
- native tagging stays the default; /usr/sbin/yt921x-tagging switches
  at runtime (status | native | 8021q) for A/B measurements.

This is the first step towards PPE flow offload: the PPE can only map
switch ports it can classify, and it classifies by VLAN.
---
 .../base-files/usr/sbin/yt921x-tagging        |  31 +
 .../linux/qualcommbe/ipq53xx/config-default   |   1 +
 ...-dsa-yt921x-add-802.1Q-based-tagging.patch | 883 ++++++++++++++++++
 3 files changed, 915 insertions(+)
 create mode 100755 target/linux/qualcommbe/ipq53xx/base-files/usr/sbin/yt921x-tagging
 create mode 100644 target/linux/qualcommbe/patches-6.18/9114-net-dsa-yt921x-add-802.1Q-based-tagging.patch

diff --git a/target/linux/qualcommbe/ipq53xx/base-files/usr/sbin/yt921x-tagging b/target/linux/qualcommbe/ipq53xx/base-files/usr/sbin/yt921x-tagging
new file mode 100755
index 0000000..4902912
--- /dev/null
+++ b/target/linux/qualcommbe/ipq53xx/base-files/usr/sbin/yt921x-tagging
@@ -0,0 +1,31 @@
+#!/bin/sh
+# Show or switch the DSA tagging of the YT9215S switch:
+#   native  Motorcomm 0x9988 header (default)
+#   8021q   802.1Q VLANs 4001+ / 4017+ per port
+# Switching takes the wired network down for a few seconds; run it from
+# Wi-Fi or the serial console. The choice lasts until the next reboot.
+
+CONDUIT=eth0
+TAGGING=/sys/class/net/$CONDUIT/dsa/tagging
+
+[ -w "$TAGGING" ] || { echo "no DSA switch behind $CONDUIT" >&2; exit 1; }
+
+case "$1" in
+""|status) cat "$TAGGING"; exit 0 ;;
+native) proto=yt921x ;;
+8021q) proto=yt921x-8021q ;;
+*) echo "usage: ${0##*/} [status|native|8021q]" >&2; exit 1 ;;
+esac
+
+[ "$(cat "$TAGGING")" = "$proto" ] && exit 0
+
+/etc/init.d/network stop
+for upper in /sys/class/net/$CONDUIT/upper_*; do
+	[ -e "$upper" ] && ip link set "${upper##*/upper_}" down
+done
+ip link set "$CONDUIT" down
+
+echo "$proto" > "$TAGGING" || echo "failed to switch to $proto" >&2
+
+/etc/init.d/network start
+cat "$TAGGING"
diff --git a/target/linux/qualcommbe/ipq53xx/config-default b/target/linux/qualcommbe/ipq53xx/config-default
index 05ae6c6..258f94b 100644
--- a/target/linux/qualcommbe/ipq53xx/config-default
+++ b/target/linux/qualcommbe/ipq53xx/config-default
@@ -33,6 +33,7 @@ CONFIG_NET_DSA=y
 CONFIG_NET_DSA_QCA8K=y
 CONFIG_NET_DSA_TAG_QCA=y
 CONFIG_NET_DSA_TAG_YT921X=y
+CONFIG_NET_DSA_TAG_YT921X_8021Q=y
 CONFIG_NET_DSA_YT921X=y
 # CONFIG_NVMEM_SPMI_SDAM is not set
 CONFIG_PHY_QCOM_UNIPHY_PCIE_28LP=y
diff --git a/target/linux/qualcommbe/patches-6.18/9114-net-dsa-yt921x-add-802.1Q-based-tagging.patch b/target/linux/qualcommbe/patches-6.18/9114-net-dsa-yt921x-add-802.1Q-based-tagging.patch
new file mode 100644
index 0000000..1bd9134
--- /dev/null
+++ b/target/linux/qualcommbe/patches-6.18/9114-net-dsa-yt921x-add-802.1Q-based-tagging.patch
@@ -0,0 +1,883 @@
+From: OpenWrt RD16 port
+Subject: [PATCH] net: dsa: yt921x: add 802.1Q based tagging
+
+Add DSA_TAG_PROTO_YT921X_8021Q ("yt921x-8021q") as an alternative to the
+native 8-byte 0x9988 tag. The switch tags frames to the CPU with an RX
+VLAN per ingress port (4001 + port), and the CPU addresses a port through
+its TX VLAN (4017 + port), whose only other member is that port. The
+conduit then only sees standard 802.1Q frames, which its parser
+understands: checksum offload and TSO, and a packet processor that
+classifies by VLAN (the IPQ5332 PPE) can map the ports.
+
+The idea and the switch register setup come from the RomikB/openwrt
+openwrt-24-rd15 yt-921x-dsa driver (Linux 5.4, for NSS PPE offload).
+Unlike that driver, ports bridged together are members of each other's
+RX VLANs, so LAN to LAN traffic is still switched in hardware, and the
+RX path keeps the precise source port.
+
+Native tagging stays the default. Switch at runtime with all ports and
+the conduit down:
+
+  echo yt921x-8021q > /sys/class/net/eth0/dsa/tagging
+
+or with dsa-tag-protocol = "yt921x-8021q" on the CPU port in DT.
+Limitations of the 802.1Q mode: VLAN-aware bridges are refused, MSTI 15
+is reserved, and frames the switch traps to the CPU (reserved multicast)
+arrive untagged and are dropped.
+
+---
+diff --git a/drivers/net/dsa/Kconfig b/drivers/net/dsa/Kconfig
+index 6dc561982..5a48d0e7f 100644
+--- a/drivers/net/dsa/Kconfig
++++ b/drivers/net/dsa/Kconfig
+@@ -157,6 +157,7 @@ config NET_DSA_VITESSE_VSC73XX_PLATFORM
+ config NET_DSA_YT921X
+ 	tristate "Motorcomm YT9215 ethernet switch chip support"
+ 	select NET_DSA_TAG_YT921X
++	select NET_DSA_TAG_YT921X_8021Q
+ 	help
+ 	  This enables support for the Motorcomm YT9215 ethernet switch
+ 	  chip.
+diff --git a/drivers/net/dsa/yt921x.c b/drivers/net/dsa/yt921x.c
+index 9dbb3568b..f425c2538 100644
+--- a/drivers/net/dsa/yt921x.c
++++ b/drivers/net/dsa/yt921x.c
+@@ -8,6 +8,7 @@
+  * Copyright (c) 2025 David Yang
+  */
+ 
++#include <linux/dsa/yt921x.h>
+ #include <linux/etherdevice.h>
+ #include <linux/gpio/consumer.h>
+ #include <linux/if_bridge.h>
+@@ -1740,6 +1741,16 @@ yt921x_dsa_port_vlan_filtering(struct dsa_switch *ds, int port,
+ 	if (dsa_is_cpu_port(ds, port))
+ 		return 0;
+ 
++	/* All ports stay VLAN-unaware with 802.1Q tagging */
++	if (priv->tag_8021q) {
++		if (!vlan_filtering)
++			return 0;
++
++		NL_SET_ERR_MSG_MOD(extack,
++				   "VLAN-aware bridges are not supported with yt921x-8021q tagging");
++		return -EOPNOTSUPP;
++	}
++
+ 	mutex_lock(&priv->reg_lock);
+ 	res = yt921x_vlan_filtering(priv, port, vlan_filtering);
+ 	mutex_unlock(&priv->reg_lock);
+@@ -1756,6 +1767,10 @@ yt921x_dsa_port_vlan_del(struct dsa_switch *ds, int port,
+ 	u16 pvid;
+ 	int res;
+ 
++	/* VLAN-unaware only; see yt921x_dsa_port_vlan_filtering() */
++	if (priv->tag_8021q)
++		return 0;
++
+ 	if (dsa_is_cpu_port(ds, port))
+ 		return 0;
+ 
+@@ -1790,6 +1805,10 @@ yt921x_dsa_port_vlan_add(struct dsa_switch *ds, int port,
+ 	u16 pvid;
+ 	int res;
+ 
++	/* VLAN-unaware only; see yt921x_dsa_port_vlan_filtering() */
++	if (priv->tag_8021q)
++		return 0;
++
+ 	/* CPU port is supposed to be a member of every VLAN; see
+ 	 * yt921x_vlan_add() and yt921x_port_setup()
+ 	 */
+@@ -1961,6 +1980,358 @@ yt921x_bridge_join(struct yt921x_priv *priv, int port, u16 ports_mask)
+ 	return 0;
+ }
+ 
++static int yt921x_port_setup(struct yt921x_priv *priv, int port);
++
++static int yt921x_native_setup(struct yt921x_priv *priv)
++{
++	unsigned long cpu_ports_mask;
++	u32 ctrl;
++	int port;
++	int res;
++
++	ctrl = YT921X_EXT_CPU_PORT_TAG_EN | YT921X_EXT_CPU_PORT_PORT_EN |
++	       YT921X_EXT_CPU_PORT_PORT(__ffs(priv->cpu_ports_mask));
++	res = yt921x_reg_write(priv, YT921X_EXT_CPU_PORT, ctrl);
++	if (res)
++		return res;
++
++	/* Setup software switch */
++	ctrl = YT921X_CPU_COPY_TO_EXT_CPU;
++	res = yt921x_reg_write(priv, YT921X_CPU_COPY, ctrl);
++	if (res)
++		return res;
++
++	ctrl = GENMASK(10, 0);
++	res = yt921x_reg_write(priv, YT921X_FILTER_UNK_UCAST, ctrl);
++	if (res)
++		return res;
++	res = yt921x_reg_write(priv, YT921X_FILTER_UNK_MCAST, ctrl);
++	if (res)
++		return res;
++
++	/* YT921x does not support native DSA port bridging, so we use port
++	 * isolation to emulate it. However, be especially careful that port
++	 * isolation takes _after_ FDB lookups, i.e. if an FDB entry (from
++	 * another bridge) is matched and the destination port (in another
++	 * bridge) is blocked, the packet will be dropped instead of flooding to
++	 * the "bridged" ports, thus we need to trap and handle those packets by
++	 * software.
++	 *
++	 * If there is no more than one bridge, we might be able to drop them
++	 * directly given some conditions are met, but we trap them in all cases
++	 * for now.
++	 */
++	ctrl = 0;
++	for (int i = 0; i < YT921X_PORT_NUM; i++)
++		ctrl |= YT921X_ACT_UNK_ACTn_TRAP(i);
++	/* Except for CPU ports, if any packets are sent via CPU ports without
++	 * tag, they should be dropped.
++	 */
++	cpu_ports_mask = priv->cpu_ports_mask;
++	for_each_set_bit(port, &cpu_ports_mask, YT921X_PORT_NUM) {
++		ctrl &= ~YT921X_ACT_UNK_ACTn_M(port);
++		ctrl |= YT921X_ACT_UNK_ACTn_DROP(port);
++	}
++	res = yt921x_reg_write(priv, YT921X_ACT_UNK_UCAST, ctrl);
++	if (res)
++		return res;
++	res = yt921x_reg_write(priv, YT921X_ACT_UNK_MCAST, ctrl);
++	if (res)
++		return res;
++
++	return 0;
++}
++
++/* 802.1Q tagging (DSA_TAG_PROTO_YT921X_8021Q); see include/linux/dsa/yt921x.h
++ * for the VLAN layout.
++ *
++ * EXT_CPU_PORT tagging is off, so the switch forwards to the CPU port by plain
++ * VLAN rules: unknown unicast and multicast are flooded within the VLAN
++ * instead of being trapped, since trapped frames bypass egress tagging and the
++ * CPU could not tell where they came from. Bridging still relies on port
++ * isolation as in native mode, plus shared membership of the RX VLANs.
++ */
++
++/* MSTI of the TX VLANs, kept forwarding so the CPU can always send */
++#define YT921X_8021Q_TX_MSTI	(YT921X_MSTI_NUM - 1)
++
++static int yt921x_8021q_port_sync(struct yt921x_priv *priv, int port)
++{
++	struct dsa_switch *ds = &priv->ds;
++	struct dsa_port *dp = dsa_to_port(ds, port);
++	u16 rx_vid = yt921x_8021q_rx_vid(port);
++	u16 tx_vid = yt921x_8021q_tx_vid(port);
++	struct net_device *bdev;
++	u16 ports_mask;
++	u64 ctrl64;
++	u32 mask;
++	u32 ctrl;
++	int res;
++
++	bdev = dsa_port_bridge_dev_get(dp);
++	ports_mask = bdev ? dsa_bridge_ports(ds, bdev) : BIT(port);
++
++	/* RX VLAN: the port and the ports bridged with it egress untagged, the
++	 * CPU port tagged. Bridged ports learn into FID 0, where DSA installs
++	 * the entries of VLAN-unaware bridges; a standalone port does not
++	 * learn and gets a FID of its own, so no FDB entry can steer its
++	 * traffic away from the CPU.
++	 */
++	ctrl64 = YT921X_VLAN_CTRL_PORTS(ports_mask | priv->cpu_ports_mask) |
++		 YT921X_VLAN_CTRL_UNTAG_PORTS(ports_mask);
++	if (bdev)
++		ctrl64 |= YT921X_VLAN_CTRL_FID(0);
++	else
++		ctrl64 |= YT921X_VLAN_CTRL_FID(rx_vid) |
++			  YT921X_VLAN_CTRL_LEARN_DIS;
++	res = yt921x_reg64_write(priv, YT921X_VLANn_CTRL(rx_vid), ctrl64);
++	if (res)
++		return res;
++
++	/* TX VLAN: the CPU port and this port only. Nothing is ever learnt in
++	 * its FID, so frames are always flooded, i.e. sent to this port.
++	 */
++	ctrl64 = YT921X_VLAN_CTRL_PORTS(BIT(port) | priv->cpu_ports_mask) |
++		 YT921X_VLAN_CTRL_UNTAG_PORTn(port) |
++		 YT921X_VLAN_CTRL_FID(tx_vid) |
++		 YT921X_VLAN_CTRL_STP_ID(YT921X_8021Q_TX_MSTI) |
++		 YT921X_VLAN_CTRL_LEARN_DIS;
++	res = yt921x_reg64_write(priv, YT921X_VLANn_CTRL(tx_vid), ctrl64);
++	if (res)
++		return res;
++
++	res = yt921x_port_set_pvid(priv, port, rx_vid);
++	if (res)
++		return res;
++
++	/* VLAN-unaware: tags of user VLANs stay in the payload */
++	mask = YT921X_PORT_IGR_TPIDn_CTAG_M;
++	res = yt921x_reg_clear_bits(priv, YT921X_PORTn_IGR_TPID(port), mask);
++	if (res)
++		return res;
++
++	mask = YT921X_PORT_VLAN_CTRL1_CVLAN_DROP_TAGGED |
++	       YT921X_PORT_VLAN_CTRL1_CVLAN_DROP_UNTAGGED;
++	res = yt921x_reg_clear_bits(priv, YT921X_PORTn_VLAN_CTRL1(port), mask);
++	if (res)
++		return res;
++
++	mask = YT921X_PORT_EGR_VLAN_CTRL_CTAG_MODE_M |
++	       YT921X_PORT_EGR_VLAN_CTRL_CTAG_KEEP |
++	       YT921X_PORT_EGR_VLAN_CTRL_STAG_KEEP;
++	ctrl = YT921X_PORT_EGR_VLAN_CTRL_CTAG_UNTAGGED;
++	res = yt921x_reg_update_bits(priv, YT921X_PORTn_EGR_VLAN_CTRL(port),
++				     mask, ctrl);
++	if (res)
++		return res;
++
++	return yt921x_reg_set_bits(priv, YT921X_VLAN_EGR_FILTER,
++				   YT921X_VLAN_EGR_FILTER_PORTn(port));
++}
++
++static int yt921x_8021q_ports_sync(struct yt921x_priv *priv, u16 ports_mask)
++{
++	unsigned long targets_mask = ports_mask & ~priv->cpu_ports_mask;
++	int port;
++	int res;
++
++	for_each_set_bit(port, &targets_mask, YT921X_PORT_NUM) {
++		res = yt921x_8021q_port_sync(priv, port);
++		if (res)
++			return res;
++	}
++
++	return 0;
++}
++
++static int yt921x_8021q_cpu_setup(struct yt921x_priv *priv, int port)
++{
++	u32 mask;
++	u32 ctrl;
++	int res;
++
++	/* Forwarding is fully decided by the VLANs */
++	res = yt921x_reg_write(priv, YT921X_PORTn_ISOLATION(port), 0);
++	if (res)
++		return res;
++
++	/* Classify by the tag the tagger inserted */
++	mask = YT921X_PORT_IGR_TPIDn_CTAG_M;
++	ctrl = YT921X_PORT_IGR_TPIDn_CTAG(0);
++	res = yt921x_reg_update_bits(priv, YT921X_PORTn_IGR_TPID(port),
++				     mask, ctrl);
++	if (res)
++		return res;
++
++	mask = YT921X_PORT_EGR_VLAN_CTRL_CTAG_MODE_M |
++	       YT921X_PORT_EGR_VLAN_CTRL_CTAG_KEEP |
++	       YT921X_PORT_EGR_VLAN_CTRL_STAG_KEEP;
++	ctrl = YT921X_PORT_EGR_VLAN_CTRL_CTAG_TAGGED;
++	res = yt921x_reg_update_bits(priv, YT921X_PORTn_EGR_VLAN_CTRL(port),
++				     mask, ctrl);
++	if (res)
++		return res;
++
++	res = yt921x_reg_update_bits(priv, YT921X_PORTn_EGR(port),
++				     YT921X_PORT_EGR_TPID_CTAG_M,
++				     YT921X_PORT_EGR_TPID_CTAG(0));
++	if (res)
++		return res;
++
++	return yt921x_reg_set_bits(priv, YT921X_VLAN_EGR_FILTER,
++				   YT921X_VLAN_EGR_FILTER_PORTn(port));
++}
++
++static int yt921x_8021q_setup(struct yt921x_priv *priv)
++{
++	u32 ctrl;
++	int res;
++
++	res = yt921x_reg_write(priv, YT921X_EXT_CPU_PORT, 0);
++	if (res)
++		return res;
++	res = yt921x_reg_write(priv, YT921X_CPU_COPY, 0);
++	if (res)
++		return res;
++
++	res = yt921x_reg_write(priv, YT921X_FILTER_UNK_UCAST, 0);
++	if (res)
++		return res;
++	res = yt921x_reg_write(priv, YT921X_FILTER_UNK_MCAST, 0);
++	if (res)
++		return res;
++
++	ctrl = 0;
++	for (int i = 0; i < YT921X_PORT_NUM; i++)
++		ctrl |= YT921X_ACT_UNK_ACTn_FORWARD(i);
++	res = yt921x_reg_write(priv, YT921X_ACT_UNK_UCAST, ctrl);
++	if (res)
++		return res;
++	res = yt921x_reg_write(priv, YT921X_ACT_UNK_MCAST, ctrl);
++	if (res)
++		return res;
++
++	res = yt921x_reg_write(priv, YT921X_TPID_IGRn(0), ETH_P_8021Q);
++	if (res)
++		return res;
++	res = yt921x_reg_write(priv, YT921X_TPID_EGRn(0), ETH_P_8021Q);
++	if (res)
++		return res;
++
++	ctrl = 0;
++	for (int i = 0; i < YT921X_PORT_NUM; i++)
++		ctrl |= YT921X_STP_PORTn_FORWARD(i);
++	return yt921x_reg_write(priv, YT921X_STPn(YT921X_8021Q_TX_MSTI), ctrl);
++}
++
++static int yt921x_native_restore(struct yt921x_priv *priv)
++{
++	struct dsa_switch *ds = &priv->ds;
++	struct dsa_port *dp;
++	int res;
++
++	res = yt921x_native_setup(priv);
++	if (res)
++		return res;
++
++	res = yt921x_reg_write(priv, YT921X_VLAN_EGR_FILTER,
++			       priv->native_vlan_egr_filter);
++	if (res)
++		return res;
++
++	for (int i = 0; i < YT921X_PORT_NUM; i++) {
++		res = yt921x_reg_write(priv, YT921X_PORTn_EGR_VLAN_CTRL(i),
++				       priv->native_egr_vlan_ctrl[i]);
++		if (res)
++			return res;
++
++		res = yt921x_reg64_write(priv,
++					 YT921X_VLANn_CTRL(yt921x_8021q_rx_vid(i)),
++					 0);
++		if (res)
++			return res;
++		res = yt921x_reg64_write(priv,
++					 YT921X_VLANn_CTRL(yt921x_8021q_tx_vid(i)),
++					 0);
++		if (res)
++			return res;
++	}
++
++	dsa_switch_for_each_cpu_port(dp, ds) {
++		res = yt921x_port_setup(priv, dp->index);
++		if (res)
++			return res;
++	}
++
++	dsa_switch_for_each_user_port(dp, ds) {
++		struct net_device *bdev = dsa_port_bridge_dev_get(dp);
++
++		res = yt921x_port_setup(priv, dp->index);
++		if (res)
++			return res;
++
++		if (bdev) {
++			u16 ports_mask;
++
++			ports_mask = dsa_bridge_ports(ds, bdev);
++			ports_mask |= priv->cpu_ports_mask;
++			res = yt921x_bridge_join(priv, dp->index, ports_mask);
++		} else {
++			res = yt921x_isolate(priv, dp->index);
++		}
++		if (res)
++			return res;
++	}
++
++	return 0;
++}
++
++static int yt921x_set_tag_8021q(struct yt921x_priv *priv, bool tag_8021q)
++{
++	struct dsa_switch *ds = &priv->ds;
++	struct dsa_port *dp;
++	int res;
++
++	if (tag_8021q == priv->tag_8021q)
++		return 0;
++
++	if (!tag_8021q) {
++		priv->tag_8021q = false;
++		return yt921x_native_restore(priv);
++	}
++
++	res = yt921x_reg_read(priv, YT921X_VLAN_EGR_FILTER,
++			      &priv->native_vlan_egr_filter);
++	if (res)
++		return res;
++	for (int i = 0; i < YT921X_PORT_NUM; i++) {
++		res = yt921x_reg_read(priv, YT921X_PORTn_EGR_VLAN_CTRL(i),
++				      &priv->native_egr_vlan_ctrl[i]);
++		if (res)
++			return res;
++	}
++
++	priv->tag_8021q = true;
++
++	res = yt921x_8021q_setup(priv);
++	if (res)
++		return res;
++
++	dsa_switch_for_each_cpu_port(dp, ds) {
++		res = yt921x_8021q_cpu_setup(priv, dp->index);
++		if (res)
++			return res;
++	}
++
++	dsa_switch_for_each_user_port(dp, ds) {
++		res = yt921x_8021q_port_sync(priv, dp->index);
++		if (res)
++			return res;
++	}
++
++	return 0;
++}
++
+ static int
+ yt921x_bridge_flags(struct yt921x_priv *priv, int port,
