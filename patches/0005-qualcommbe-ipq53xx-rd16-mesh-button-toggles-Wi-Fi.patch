From 175f1e66069a04adf0edcc72c7c7b004009bf92e Mon Sep 17 00:00:00 2001
From: OpenWrt-Xiaomi-RD16-port <rd16@localhost>
Date: Mon, 19 Oct 2026 21:52:42 +0300
Subject: [PATCH] qualcommbe: ipq53xx: rd16: mesh button toggles Wi-Fi

The "mesh" key sent KEY_WPS_BUTTON, but WPS is not enabled on the APs
(and wpad-basic has no WPS), so it did nothing. Send KEY_RFKILL instead:
OpenWrt's /etc/rc.button/rfkill then switches both radios off and on.
The reset key is unchanged: short press reboots, >= 5 s factory reset.
---
 target/linux/qualcommbe/dts/ipq5332-xiaomi-rd16.dts | 9 ++++++---
 1 file changed, 6 insertions(+), 3 deletions(-)

diff --git a/target/linux/qualcommbe/dts/ipq5332-xiaomi-rd16.dts b/target/linux/qualcommbe/dts/ipq5332-xiaomi-rd16.dts
index 5a1ce0a14a..014d103ab3 100644
--- a/target/linux/qualcommbe/dts/ipq5332-xiaomi-rd16.dts
+++ b/target/linux/qualcommbe/dts/ipq5332-xiaomi-rd16.dts
@@ -17,7 +17,7 @@
  *   offsets (IPQ5332 0x1000/0x11800, QCN6432 0x12800/0x1b800), same
  *   layout as GL-BE3600; extracted by hotplug 12-ath12k-caldata.
  * - LEDs: PWM RGB (blue = pwm ch2 / gpio30, orange = pwm ch1 / gpio31).
- * - Buttons: reset GPIO43, mesh/WPS GPIO35 (both active low).
+ * - Buttons: reset GPIO43 (reboot / factory reset), mesh GPIO35 (Wi-Fi on/off), both active low.
  *
  * All facts are taken from the stock QSDK 5.4 DTB and the stock boot log.
  *
@@ -200,9 +200,12 @@
 				debounce-interval = <60>;
 			};
 
-			wps {
+			/* "Mesh" key on the case: toggles both Wi-Fi radios on/off
+			 * (/etc/rc.button/rfkill); WPS is not enabled on the APs.
+			 */
+			mesh {
 				label = "mesh";
-				linux,code = <KEY_WPS_BUTTON>;
+				linux,code = <KEY_RFKILL>;
 				gpios = <&tlmm 35 GPIO_ACTIVE_LOW>;
 				debounce-interval = <60>;
 			};
-- 
2.43.0

