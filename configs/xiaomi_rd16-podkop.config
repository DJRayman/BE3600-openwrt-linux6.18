# Added on top of xiaomi_rd16.config for the "podkop" image variant
# (build.sh builds both). podkop itself comes from the itdoginfo/podkop
# feed that build.sh adds (it also turns podkop's "+sing-box" into a
# plain dependency: sing-box-tiny PROVIDES sing-box, and the selecting form
# is a Kconfig recursion).
CONFIG_PACKAGE_podkop=y
CONFIG_PACKAGE_luci-app-podkop=y
# the full sing-box (not -tiny); without tailscale/gvisor: podkop uses
# tproxy, not TUN, and both add megabytes of binary and RAM on a box with
# ~35 MiB available
CONFIG_PACKAGE_sing-box=y
# CONFIG_PACKAGE_sing-box-tiny is not set
# CONFIG_SINGBOX_WITH_TAILSCALE is not set
# CONFIG_SINGBOX_WITH_GVISOR is not set
# Russian LuCI (also pulls luci-i18n-podkop-ru)
CONFIG_LUCI_LANG_ru=y
# WireGuard: kernel module, wg tool, LuCI protocol page
CONFIG_PACKAGE_kmod-wireguard=y
CONFIG_PACKAGE_wireguard-tools=y
CONFIG_PACKAGE_luci-proto-wireguard=y
# Compressed swap in RAM: sing-box (Go) and podkop's helpers push the box
# past its ~35 MiB of free memory; anonymous pages compress ~3:1.
CONFIG_PACKAGE_zram-swap=y
