# Xiaomi BE3600 (RD16) - base image.
# Builds:
#   *-initramfs-uImage.itb    RAM boot (U-Boot TFTP), used for install/recovery
#   *-squashfs-factory.ubi    UBI image for system slot A ("rootfs" MTD)
#   *-squashfs-sysupgrade.bin update from a running OpenWrt (LuCI / sysupgrade)
CONFIG_TARGET_qualcommbe=y
CONFIG_TARGET_qualcommbe_ipq53xx=y
CONFIG_TARGET_qualcommbe_ipq53xx_DEVICE_xiaomi_rd16=y
CONFIG_TARGET_ROOTFS_INITRAMFS=y
CONFIG_TARGET_INITRAMFS_COMPRESSION_XZ=y
CONFIG_TARGET_ROOTFS_SQUASHFS=y
# Wi-Fi (the Q6 firmware itself comes from the stock rootfs, see README)
CONFIG_PACKAGE_wifi-scripts=y
CONFIG_PACKAGE_ath12k-firmware-ipq5332=y
CONFIG_PACKAGE_kmod-ath12k=y
# slot handling / recovery tools
CONFIG_PACKAGE_uboot-envtools=y
CONFIG_PACKAGE_mtd=y
CONFIG_PACKAGE_ubi-utils=y
CONFIG_PACKAGE_nand-utils=y
CONFIG_PACKAGE_ip-full=y
CONFIG_PACKAGE_kmod-leds-pwm=y
CONFIG_PACKAGE_luci=y
